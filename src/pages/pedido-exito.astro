---
import BaseLayout from '../layouts/BaseLayout.astro';

const ordenId = Astro.url.searchParams.get('orden') || '';
const metodo = Astro.url.searchParams.get('metodo') || 'whatsapp';
---

<BaseLayout title="Pedido Confirmado - Agroup">
  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-8 text-center">
      <div class="w-20 h-20 bg-gold-100 rounded-full flex items-center justify-center mx-auto mb-6">
        <svg class="w-10 h-10 text-gold-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
      </div>

      <h1 class="text-2xl font-bold text-slate-900 mb-2">¡Pedido Confirmado!</h1>
      <p class="text-slate-600 mb-6">
        {metodo === 'whatsapp' 
          ? 'Tu solicitud fue enviada. Te contactaremos pronto por WhatsApp.'
          : metodo === 'efectivo'
          ? 'Tu pedido está guardado. El vendedor te contactará para coordinar el pago.'
          : 'Tu pago está siendo procesado. Recibirás confirmación por email.'
        }
      </p>

      {ordenId && (
        <div class="bg-slate-50 rounded-xl p-4 mb-6">
          <p class="text-sm text-slate-500 mb-1">Número de orden</p>
          <p class="text-xl font-mono font-bold text-gold-700">{ordenId}</p>
        </div>
      )}

      <div class="space-y-3 mb-8">
        <a href="/marketplace" class="block w-full py-3 bg-campo-600 text-white font-semibold rounded-xl hover:bg-campo-700 transition-colors">
          Continuar Comprando
        </a>
        <a href="/dashboard" class="block w-full py-3 border border-slate-300 text-slate-700 font-semibold rounded-xl hover:bg-slate-50 transition-colors">
          Ver Mis Pedidos
        </a>
      </div>

      <div class="flex items-center justify-center gap-2 text-sm text-slate-500">
        <svg class="w-5 h-5 text-gold-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
        </svg>
        ¿Tienes dudas? <a href="https://wa.me/573001234567" class="text-gold-700 hover:underline">Escríbenos</a>
      </div>
    </div>
  </div>
</BaseLayout>