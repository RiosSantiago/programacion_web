---
import BaseLayout from '../layouts/BaseLayout.astro';

const sections = [
  {
    number: '01',
    icon: 'check',
    title: 'Aceptación de los Términos',
    content:
      'Al acceder y utilizar AgroUp, usted acepta cumplir con estos términos y condiciones. Si no está de acuerdo con alguno de estos términos, por favor no utilice la plataforma.',
  },
  {
    number: '02',
    icon: 'clipboard',
    title: 'Descripción del Servicio',
    content:
      'AgroUp es un marketplace especializado en la compra y venta de ganado (bovinos, equinos, porcinos y avícolas) en la región de Manizales, Caldas, Colombia. La plataforma facilita la conexión entre vendedores y compradores, pero no es parte directa de las transacciones.',
  },
  {
    number: '03',
    icon: 'user',
    title: 'Registro de Usuarios',
    content:
      'Para utilizar ciertas funciones de la plataforma, debe registrar una cuenta proporcionando información veraz y actualizada. Usted es responsable de mantener la confidencialidad de su contraseña.',
  },
  {
    number: '04',
    icon: 'search',
    title: 'Publicaciones y Ventas',
    content:
      'Los vendedores son responsables de la información proporcionada en sus publicaciones. Todo el ganado publicado debe ser de su legítima propiedad. AgroUp se reserva el derecho de remover publicaciones que infrinjan estas condiciones.',
  },
  {
    number: '05',
    icon: 'shield',
    title: 'Pagos y Transacciones',
    content:
      'Los pagos se procesan a través de Wompi (PSE, Nequi, Daviplata, tarjetas). AgroUp no almacena información de pago. Las transacciones son responsabilidad directa entre comprador y vendedor.',
  },
  {
    number: '06',
    icon: 'server',
    title: 'Limitación de Responsabilidad',
    content:
      'AgroUp actúa únicamente como intermediario. No somos responsables por condiciones de salud, calidad o cualquier otro aspecto del ganado transado. Se recomienda realizar inspecciones presenciales antes de completar cualquier compra.',
  },
  {
    number: '07',
    icon: 'clipboard',
    title: 'Propiedad Intelectual',
    content:
      'Todo el contenido de la plataforma, incluyendo textos, gráficos y logos, está protegido por derechos de autor.',
  },
  {
    number: '08',
    icon: 'cookie',
    title: 'Modificaciones',
    content:
      'Nos reservamos el derecho de modificar estos términos en cualquier momento. Los cambios serán efectivos al momento de su publicación.',
  },
  {
    number: '09',
    icon: 'mail',
    title: 'Contacto',
    content:
      'Para cualquier duda sobre estos términos, contáctenos a través de WhatsApp o al correo agroup.campo@gmail.com',
  },
];
---

<BaseLayout title="Términos y Condiciones - AgroUp" navVariant="light">
  <!-- Hero Section -->
  <section class="relative overflow-hidden">
    <img
      src="/images/Privacidad-banner.webp"
      alt=""
      class="absolute inset-0 w-full h-full object-cover object-center"
      aria-hidden="true"
    />
    <div class="absolute inset-0 bg-black/60"></div>

    <div class="absolute top-8 right-12 text-white/5">
      <svg width="160" height="160" viewBox="0 0 24 24" fill="currentColor">
        <path d="M3 21h18M9 21V10l6-6M9 21l6-12M9 21l4-8M15 21l-2 8M15 21l2-4" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
    <div class="absolute bottom-8 left-12 text-white/5 rotate-45">
      <svg width="120" height="120" viewBox="0 0 24 24" fill="currentColor">
        <path d="M3 21h18M9 21V10l6-6M9 21l6-12M9 21l4-8M15 21l-2 8M15 21l2-4" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>

    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-40 md:py-56">
      <div class="flex flex-col items-center text-center">
        <div class="w-16 h-16 md:w-20 md:h-20 bg-gradient-to-br from-gold-400 to-gold-600 rounded-2xl flex items-center justify-center shadow-lg shadow-gold-900/20 mb-6">
          <svg class="w-8 h-8 md:w-10 md:h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
          </svg>
        </div>

        <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-bold text-white leading-tight drop-shadow-[0_2px_8px_rgba(0,0,0,0.5)]">
          Términos y Condiciones
        </h1>
        <p class="mt-4 text-lg md:text-xl text-white/90 font-light max-w-2xl drop-shadow-[0_1px_4px_rgba(0,0,0,0.4)]">
          Al utilizar AgroUp, aceptas nuestros términos. Te recomendamos leerlos detenidamente.
        </p>
      </div>
    </div>
  </section>

  <!-- Content Sections -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <div class="space-y-8">
      {
        sections.map((section) => (
          <article
            class="group bg-white rounded-2xl border border-[#E8E0D8] shadow-sm hover:shadow-md transition-all duration-300 overflow-hidden"
          >
            <div class="flex gap-6 p-6 md:p-8">
              <div class="hidden md:flex flex-col items-center gap-2">
                <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-campo-50 to-campo-100 border border-campo-200 flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform duration-300">
                  <span class="text-sm font-bold text-campo-700">{section.number}</span>
                </div>
                <div class="w-px flex-1 bg-gradient-to-b from-campo-200 to-transparent"></div>
              </div>

              <div class="flex-1 min-w-0">
                <div class="flex items-start gap-4 mb-4">
                  <div class="w-10 h-10 rounded-lg bg-gold-50 border border-gold-200 flex items-center justify-center flex-shrink-0 md:hidden">
                    <span class="text-xs font-bold text-gold-700">{section.number}</span>
                  </div>
                  <div class="flex-1">
                    <h2 class="text-xl md:text-2xl font-display font-semibold text-campo-900">
                      {section.title}
                    </h2>
                    <div class="h-0.5 w-12 bg-gradient-to-r from-gold-400 to-gold-500 rounded-full mt-2"></div>
                  </div>
                  <div class="hidden sm:flex w-10 h-10 rounded-lg bg-campo-50 border border-campo-200 items-center justify-center flex-shrink-0 group-hover:bg-campo-100 transition-colors">
                    {
                      section.icon === 'clipboard' && (
                        <svg class="w-5 h-5 text-campo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15a2.25 2.25 0 012.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25zM6.75 12h.008v.008H6.75V12zm0 3h.008v.008H6.75V15zm0 3h.008v.008H6.75V18z" />
                        </svg>
                      )
                    }
                    {
                      section.icon === 'search' && (
                        <svg class="w-5 h-5 text-campo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
                        </svg>
                      )
                    }
                    {
                      section.icon === 'shield' && (
                        <svg class="w-5 h-5 text-campo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
                        </svg>
                      )
                    }
                    {
                      section.icon === 'server' && (
                        <svg class="w-5 h-5 text-campo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5z" />
                        </svg>
                      )
                    }
                    {
                      section.icon === 'check' && (
                        <svg class="w-5 h-5 text-campo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                      )
                    }
                    {
                      section.icon === 'cookie' && (
                        <svg class="w-5 h-5 text-campo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25zm-2.625 6a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm3.75 5.25a.75.75 0 100-1.5.75.75 0 000 1.5zm3-1.5a.75.75 0 11-1.5 0 .75.75 0 011.5 0z" />
                        </svg>
                      )
                    }
                    {
                      section.icon === 'mail' && (
                        <svg class="w-5 h-5 text-campo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                        </svg>
                      )
                    }
                    {
                      section.icon === 'user' && (
                        <svg class="w-5 h-5 text-campo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
                        </svg>
                      )
                    }
                  </div>
                </div>

                <p class="text-muted leading-relaxed">{section.content}</p>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <!-- CTA -->
    <div class="mt-12 bg-gradient-to-br from-campo-900 to-campo-800 rounded-2xl overflow-hidden shadow-xl">
      <div class="relative p-8 md:p-10">
        <div class="absolute top-0 right-0 w-64 h-64 bg-white/5 rounded-full -translate-y-1/2 translate-x-1/2"></div>
        <div class="absolute bottom-0 left-0 w-48 h-48 bg-gold-500/5 rounded-full translate-y-1/2 -translate-x-1/2"></div>

        <div class="relative flex flex-col md:flex-row items-center gap-6">
          <div class="w-16 h-16 bg-gradient-to-br from-gold-400 to-gold-600 rounded-2xl flex items-center justify-center flex-shrink-0 shadow-lg">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 8.511c.884.284 1.5 1.128 1.5 2.097v4.286c0 1.136-.847 2.1-1.98 2.193-.34.027-.68.052-1.02.072v3.091l-3-3c-1.354 0-2.694-.055-4.02-.163a2.115 2.115 0 01-.825-.242m9.345-8.334a2.126 2.126 0 00-.476-.095 48.64 48.64 0 00-8.048 0c-1.131.094-1.976 1.057-1.976 2.192v4.286c0 .837.46 1.58 1.155 1.951m9.345-8.334V6.637c0-1.621-1.152-3.026-2.76-3.235A48.455 48.455 0 0011.25 3c-2.115 0-4.198.137-6.24.402-1.608.209-2.76 1.614-2.76 3.235v6.226c0 1.621 1.152 3.026 2.76 3.235.577.075 1.157.14 1.74.194V21l4.155-4.155" />
            </svg>
          </div>

          <div class="flex-1 text-center md:text-left">
            <h3 class="text-2xl font-display font-bold text-white">¿Tienes dudas sobre los términos?</h3>
            <p class="text-white/80 mt-2">
              Estamos aquí para ayudarte. Contáctanos directamente y te responderemos a la brevedad.
            </p>
          </div>

          <div class="flex flex-col sm:flex-row gap-3">
            <a
              href="https://wa.me/573001234567"
              class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-gold-500 hover:bg-gold-600 text-campo-900 font-bold rounded-xl transition-all duration-200 active:scale-[0.98] shadow-lg shadow-gold-900/20"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
              </svg>
              WhatsApp
            </a>
            <a
              href="mailto:agroup.campo@gmail.com"
              class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-white/10 hover:bg-white/20 text-white font-semibold rounded-xl transition-all duration-200 border border-white/20 active:scale-[0.98]"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
              </svg>
              Correo Electrónico
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  nav#main-nav[data-variant="light"]:not(.scrolled) {
    border-bottom: 1px solid rgba(255,255,255,0.15);
    background: transparent;
  }
  body:has(nav#main-nav[data-variant="light"]) main {
    padding-top: 0;
  }
</style>
