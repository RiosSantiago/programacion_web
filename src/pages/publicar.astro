---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationForm from '../components/dashboard/PublicationForm';
---

<BaseLayout navVariant="publicar">
  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <nav class="flex items-center gap-2 text-sm text-slate-500 mb-6">
      <a href="/" class="hover:text-gold-700 transition-colors">Marketplace</a>
      <span>/</span>
      <span class="text-slate-900 font-medium">Publicar</span>
    </nav>

    <div class="bg-white rounded-xl border border-slate-200 shadow-sm">
      <div class="px-6 py-4 border-b border-slate-200 bg-campo-800">
        <h1 class="text-2xl font-bold text-white">Publicar mi Ganado</h1>
        <p class="text-sm text-white/80 mt-1">Completa el formulario para publicar tu animal</p>
      </div>

      <div class="p-6">
        <PublicationForm client:load />
      </div>
    </div>

    <div class="mt-6 text-center">
      <a href="/marketplace" class="text-sm text-gold-700 hover:underline">
        ← Volver al Marketplace
      </a>
    </div>
  </div>
</BaseLayout>