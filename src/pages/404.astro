---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <div class="min-h-[60vh] flex items-center justify-center">
    <div class="text-center">
      <h1 class="text-6xl font-bold text-slate-200">404</h1>
      <h2 class="text-2xl font-bold text-slate-900 mt-4">Página no encontrada</h2>
      <p class="text-slate-500 mt-2">Lo sentimos, la página que buscas no existe.</p>
      <a
        href="/"
        class="inline-block mt-6 px-6 py-3 bg-campo-600 text-white font-semibold rounded-lg hover:bg-campo-700 transition-colors"
      >
        Volver al inicio
      </a>
    </div>
  </div>
</BaseLayout>
