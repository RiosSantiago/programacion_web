---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Sobre Nosotros - Agroup">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-8 mb-8">
      <div class="text-center mb-8">
        <div class="w-20 h-20 bg-gradient-to-br from-gold-500 to-gold-700 rounded-2xl flex items-center justify-center text-white text-3xl font-bold mx-auto mb-4">
          A
        </div>
        <h1 class="text-3xl font-bold text-slate-900">Agroup</h1>
        <p class="text-gold-700 font-medium mt-2">El marketplace ganadero de los Andes</p>
      </div>

      <div class="prose prose-slate max-w-none">
        <h2 class="text-xl font-semibold text-slate-800 mb-4">Nuestra Misión</h2>
        <p class="text-slate-600 mb-6">Facilitar la compra y venta de ganado en la región de Manizales y Caldas, conectando directamente a productores y compradores con tecnología moderna y segura.</p>

        <h2 class="text-xl font-semibold text-slate-800 mb-4">Por qué Agroup</h2>
        <div class="grid md:grid-cols-3 gap-6 mb-8">
          <div class="text-center p-4 bg-gold-50 rounded-xl">
            <div class="w-12 h-12 bg-gold-100 rounded-full flex items-center justify-center mx-auto mb-3">
              <svg class="w-6 h-6 text-gold-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              </svg>
            </div>
            <h3 class="font-semibold text-slate-800">Local</h3>
            <p class="text-sm text-slate-600">Enfocados en Manizales y Caldas</p>
          </div>
          <div class="text-center p-4 bg-gold-50 rounded-xl">
            <div class="w-12 h-12 bg-gold-100 rounded-full flex items-center justify-center mx-auto mb-3">
              <svg class="w-6 h-6 text-gold-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <h3 class="font-semibold text-slate-800">Seguro</h3>
            <p class="text-sm text-slate-600">Pagos protegidos con Wompi</p>
          </div>
          <div class="text-center p-4 bg-gold-50 rounded-xl">
            <div class="w-12 h-12 bg-gold-100 rounded-full flex items-center justify-center mx-auto mb-3">
              <svg class="w-6 h-6 text-gold-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <h3 class="font-semibold text-slate-800">WhatsApp</h3>
            <p class="text-sm text-slate-600">Comunicación directa con vendedores</p>
          </div>
        </div>

        <h2 class="text-xl font-semibold text-slate-800 mb-4">Contacto</h2>
        <p class="text-slate-600 mb-4">¿Tienes preguntas o sugerencias? Estamos aquí para ayudarte.</p>
        <a href="https://wa.me/573001234567" class="inline-flex items-center gap-2 px-6 py-3 bg-green-600 text-white font-semibold rounded-xl hover:bg-green-700 transition-colors">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
          Escríbenos por WhatsApp
        </a>
      </div>
    </div>
  </div>
</BaseLayout>