---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Sobre Nosotros - Agroup" navVariant="light">
  <!-- Hero Section -->
  <section class="relative overflow-hidden">
    <img
      src="/images/Privacidad-banner.webp"
      alt=""
      class="absolute inset-0 w-full h-full object-cover object-center"
      aria-hidden="true"
    />
    <div class="absolute inset-0 bg-black/60"></div>

    <div class="absolute top-8 right-12 text-white/5">
      <svg width="160" height="160" viewBox="0 0 24 24" fill="currentColor">
        <path d="M3 21h18M9 21V10l6-6M9 21l6-12M9 21l4-8M15 21l-2 8M15 21l2-4" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
    <div class="absolute bottom-8 left-12 text-white/5 rotate-45">
      <svg width="120" height="120" viewBox="0 0 24 24" fill="currentColor">
        <path d="M3 21h18M9 21V10l6-6M9 21l6-12M9 21l4-8M15 21l-2 8M15 21l2-4" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>

    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-40 md:py-56">
      <div class="flex flex-col items-center text-center">
        <div class="w-16 h-16 md:w-20 md:h-20 bg-gradient-to-br from-gold-400 to-gold-600 rounded-2xl flex items-center justify-center shadow-lg shadow-gold-900/20 mb-6">
          <svg class="w-8 h-8 md:w-10 md:h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" />
          </svg>
        </div>

        <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-bold text-white leading-tight drop-shadow-[0_2px_8px_rgba(0,0,0,0.5)]">
          Sobre Nosotros
        </h1>
        <p class="mt-4 text-lg md:text-xl text-white/90 font-light max-w-2xl drop-shadow-[0_1px_4px_rgba(0,0,0,0.4)]">
          Conoce más sobre Agroup, el marketplace ganadero que está transformando el campo colombiano.
        </p>
      </div>
    </div>
  </section>

  <!-- Content -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <div class="space-y-8">
      <!-- Misión -->
      <article class="bg-white rounded-2xl border border-[#E8E0D8] shadow-sm p-8">
        <div class="flex items-start gap-4 mb-4">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-campo-50 to-campo-100 border border-campo-200 flex items-center justify-center flex-shrink-0">
            <svg class="w-6 h-6 text-campo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
            </svg>
          </div>
          <div class="flex-1">
            <h2 class="text-2xl font-display font-semibold text-campo-900">Nuestra Misión</h2>
            <div class="h-0.5 w-12 bg-gradient-to-r from-gold-400 to-gold-500 rounded-full mt-2"></div>
          </div>
        </div>
        <p class="text-muted leading-relaxed text-lg">
          Facilitar la compra y venta de ganado en la región de Manizales y Caldas, conectando directamente a productores y compradores con tecnología moderna y segura.
        </p>
      </article>

      <!-- Valores -->
      <h2 class="text-2xl font-display font-semibold text-campo-900 text-center">¿Por qué Agroup?</h2>
      <div class="grid md:grid-cols-3 gap-6">
        <article class="bg-white rounded-2xl border border-[#E8E0D8] shadow-sm hover:shadow-md transition-all duration-300 p-6 text-center group">
          <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-gold-50 to-gold-100 border border-gold-200 flex items-center justify-center mx-auto mb-4 group-hover:scale-105 transition-transform duration-300">
            <svg class="w-7 h-7 text-gold-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-campo-900 mb-2">Local</h3>
          <p class="text-sm text-muted">Enfocados en Manizales y Caldas, impulsando el agro regional.</p>
        </article>

        <article class="bg-white rounded-2xl border border-[#E8E0D8] shadow-sm hover:shadow-md transition-all duration-300 p-6 text-center group">
          <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-gold-50 to-gold-100 border border-gold-200 flex items-center justify-center mx-auto mb-4 group-hover:scale-105 transition-transform duration-300">
            <svg class="w-7 h-7 text-gold-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-campo-900 mb-2">Seguro</h3>
          <p class="text-sm text-muted">Pagos protegidos con Wompi, sin riesgos para compradores y vendedores.</p>
        </article>

        <article class="bg-white rounded-2xl border border-[#E8E0D8] shadow-sm hover:shadow-md transition-all duration-300 p-6 text-center group">
          <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-gold-50 to-gold-100 border border-gold-200 flex items-center justify-center mx-auto mb-4 group-hover:scale-105 transition-transform duration-300">
            <svg class="w-7 h-7 text-gold-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 8.511c.884.284 1.5 1.128 1.5 2.097v4.286c0 1.136-.847 2.1-1.98 2.193-.34.027-.68.052-1.02.072v3.091l-3-3c-1.354 0-2.694-.055-4.02-.163a2.115 2.115 0 01-.825-.242m9.345-8.334a2.126 2.126 0 00-.476-.095 48.64 48.64 0 00-8.048 0c-1.131.094-1.976 1.057-1.976 2.192v4.286c0 .837.46 1.58 1.155 1.951m9.345-8.334V6.637c0-1.621-1.152-3.026-2.76-3.235A48.455 48.455 0 0011.25 3c-2.115 0-4.198.137-6.24.402-1.608.209-2.76 1.614-2.76 3.235v6.226c0 1.621 1.152 3.026 2.76 3.235.577.075 1.157.14 1.74.194V21l4.155-4.155" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-campo-900 mb-2">WhatsApp</h3>
          <p class="text-sm text-muted">Comunicación directa entre vendedores y compradores sin intermediarios.</p>
        </article>
      </div>

      <!-- CTA -->
      <div class="bg-gradient-to-br from-campo-900 to-campo-800 rounded-2xl overflow-hidden shadow-xl">
        <div class="relative p-8 md:p-10">
          <div class="absolute top-0 right-0 w-64 h-64 bg-white/5 rounded-full -translate-y-1/2 translate-x-1/2"></div>
          <div class="absolute bottom-0 left-0 w-48 h-48 bg-gold-500/5 rounded-full translate-y-1/2 -translate-x-1/2"></div>

          <div class="relative flex flex-col md:flex-row items-center gap-6">
            <div class="w-16 h-16 bg-gradient-to-br from-gold-400 to-gold-600 rounded-2xl flex items-center justify-center flex-shrink-0 shadow-lg">
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 8.511c.884.284 1.5 1.128 1.5 2.097v4.286c0 1.136-.847 2.1-1.98 2.193-.34.027-.68.052-1.02.072v3.091l-3-3c-1.354 0-2.694-.055-4.02-.163a2.115 2.115 0 01-.825-.242m9.345-8.334a2.126 2.126 0 00-.476-.095 48.64 48.64 0 00-8.048 0c-1.131.094-1.976 1.057-1.976 2.192v4.286c0 .837.46 1.58 1.155 1.951m9.345-8.334V6.637c0-1.621-1.152-3.026-2.76-3.235A48.455 48.455 0 0011.25 3c-2.115 0-4.198.137-6.24.402-1.608.209-2.76 1.614-2.76 3.235v6.226c0 1.621 1.152 3.026 2.76 3.235.577.075 1.157.14 1.74.194V21l4.155-4.155" />
              </svg>
            </div>

            <div class="flex-1 text-center md:text-left">
              <h3 class="text-2xl font-display font-bold text-white">¿Tienes preguntas o sugerencias?</h3>
              <p class="text-white/80 mt-2">
                Estamos aquí para ayudarte. Contáctanos directamente y te responderemos a la brevedad.
              </p>
            </div>

            <a
              href="https://wa.me/573001234567"
              class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-gold-500 hover:bg-gold-600 text-campo-900 font-bold rounded-xl transition-all duration-200 active:scale-[0.98] shadow-lg shadow-gold-900/20 flex-shrink-0"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
              </svg>
              Contáctanos
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  nav#main-nav[data-variant="light"]:not(.scrolled) {
    border-bottom: 1px solid rgba(255,255,255,0.15);
    background: transparent;
  }
  body:has(nav#main-nav[data-variant="light"]) main {
    padding-top: 0;
  }
</style>
