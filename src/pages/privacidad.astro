                      return (
                        <li class="flex items-start gap-3 text-muted">
                          <svg class="w-5 h-5 text-campo-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
