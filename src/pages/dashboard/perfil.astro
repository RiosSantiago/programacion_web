---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-8">
      <div>
        <div class="flex items-center gap-2 text-sm text-slate-500">
          <a href="/dashboard" class="hover:text-gold-700">Mi Hacienda</a>
          <span>/</span>
          <span class="text-slate-900">Perfil Público</span>
        </div>
        <h1 class="text-2xl font-bold text-slate-900 mt-2">Perfil de Hacienda Pública</h1>
        <p class="text-sm text-slate-500 mt-1">Esta información se muestra en tu perfil público del marketplace</p>
      </div>
      <div class="flex items-center gap-3">
        <a
          href={`/hacienda/${(typeof document !== 'undefined' ? (document.getElementById('nombre-hacienda') as HTMLInputElement)?.value || 'hacienda' : 'hacienda').toLowerCase().replace(/\s+/g, '-')}`}
          target="_blank"
          class="inline-flex items-center gap-2 px-4 py-2.5 border border-slate-300 text-slate-700 text-sm font-semibold rounded-lg hover:bg-slate-50 transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
          Ver Perfil Público
        </a>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Profile Card Preview -->
      <div class="lg:col-span-1">
        <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
          <div class="h-24 bg-gradient-to-r from-gold-700 to-emerald-800"></div>
          <div class="px-6 pb-6 -mt-12 text-center">
            <div class="w-24 h-24 mx-auto rounded-2xl border-4 border-white shadow-md bg-gold-100 flex items-center justify-center" id="foto-preview">
              <span class="text-3xl font-bold text-gold-800" id="foto-inicial">H</span>
            </div>
            <h2 class="text-xl font-bold text-slate-900 mt-3" id="preview-nombre">Hacienda Verde</h2>
            <p class="text-sm text-slate-500 mt-1" id="preview-ubicacion">Manizales, Caldas</p>
            <div class="flex items-center justify-center gap-1 mt-2">
              <svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 24 24">
                <path d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
              </svg>
              <span class="text-sm font-semibold text-slate-700" id="preview-rating">4.8</span>
              <span class="text-sm text-slate-400">(<span id="preview-ventas">12</span> ventas)</span>
            </div>
            <div class="mt-4 pt-4 border-t border-slate-200">
              <div class="grid grid-cols-2 gap-3 text-center">
                <div>
                  <p class="text-lg font-bold text-slate-900" id="preview-publicaciones">3</p>
                  <p class="text-xs text-slate-500">Publicaciones</p>
                </div>
                <div>
                  <p class="text-lg font-bold text-slate-900">12</p>
                  <p class="text-xs text-slate-500">Ventas</p>
                </div>
              </div>
            </div>
            <div class="mt-3 text-xs text-slate-400" id="preview-miembro">
              Miembro desde marzo 2026
            </div>
            <div class="mt-3">
              <a
                id="preview-url"
                href="#"
                target="_blank"
                class="text-xs text-gold-700 hover:underline break-all"
              >/hacienda/hacienda-verde</a>
            </div>
          </div>
        </div>
      </div>

      <!-- Edit Form -->
      <div class="lg:col-span-2">
        <div class="bg-white rounded-xl border border-slate-200 p-6">
          <h3 class="text-lg font-semibold text-slate-900 mb-6">Editar Información</h3>
          <form id="perfil-form" class="space-y-4">
            <!-- Foto / Logo -->
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-2">Foto / Logo de la Hacienda</label>
              <div class="flex items-center gap-4">
                <div class="w-20 h-20 bg-slate-100 rounded-xl flex items-center justify-center overflow-hidden border border-slate-200" id="logo-upload-preview">
                  <span class="text-2xl font-bold text-slate-400" id="logo-placeholder">+</span>
                </div>
                <div class="flex-1">
                  <input
                    type="url"
                    id="logo-url"
                    placeholder="URL de la imagen del logo"
                    class="w-full px-3 py-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-gold-500 mb-2"
                  />
                  <p class="text-xs text-slate-400">Ingresa una URL pública para tu logo, o selecciona un archivo</p>
                  <input type="file" accept="image/*" id="logo-file" class="text-sm text-slate-500 mt-1" />
                </div>
              </div>
            </div>

            <!-- Foto de Portada -->
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-2">Foto de Portada</label>
              <input type="url" id="portada-url" placeholder="URL de la imagen de portada" class="w-full px-3 py-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-gold-500" />
            </div>

            <!-- Nombre -->
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Nombre de la Hacienda *</label>
              <input
                id="nombre-hacienda"
                type="text"
                value="Hacienda Verde"
                class="w-full px-3 py-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-gold-500 input-sync"
                data-preview="preview-nombre"
              />
              <p class="text-xs text-slate-400 mt-1">URL pública: <span id="url-preview" class="text-gold-700">/hacienda/hacienda-verde</span></p>
            </div>

            <!-- Ubicacion -->
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Departamento</label>
                <select id="departamento" class="w-full px-3 py-2.5 border border-slate-300 rounded-lg text-sm bg-white input-sync" data-preview="preview-ubicacion">
                  <option value="Caldas">Caldas</option>
                  <option value="Antioquia">Antioquia</option>
                  <option value="Cundinamarca">Cundinamarca</option>
                  <option value="Boyacá">Boyacá</option>
                  <option value="Meta">Meta</option>
                  <option value="Santander">Santander</option>
                  <option value="Tolima">Tolima</option>
                  <option value="Valle del Cauca">Valle del Cauca</option>
                </select>
              </div>
              <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Municipio</label>
                <input
                  id="municipio"
                  type="text"
                  value="Manizales"
                  class="w-full px-3 py-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-gold-500 input-sync"
                  data-preview="preview-ubicacion"
                />
              </div>
            </div>

            <!-- WhatsApp -->
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">WhatsApp</label>
              <div class="flex gap-2">
                <span class="inline-flex items-center px-3 py-2.5 bg-slate-100 border border-slate-300 rounded-lg text-sm text-slate-500">+57</span>
                <input
                  id="whatsapp"
                  type="tel"
                  value="3001234567"
                  placeholder="3001234567"
                  class="flex-1 px-3 py-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-gold-500"
                />
              </div>
            </div>

            <!-- Descripcion -->
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Descripción</label>
              <textarea
                id="descripcion"
                rows={4}
                class="w-full px-3 py-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-gold-500"
                placeholder="Describe tu hacienda, prácticas y certificaciones..."
              >Hacienda familiar dedicada a la cría y engorde de ganado bovino con trazabilidad completa.</textarea>
              <p class="text-xs text-slate-400 mt-1">Texto libre donde describes tu hacienda, prácticas de producción y certificaciones.</p>
            </div>

            <!-- Especies -->
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-2">Especies que maneja</label>
              <div class="flex flex-wrap gap-2">
                {['Bovinos', 'Equinos', 'Porcinos', 'Avícolas', 'Agricultura'].map((specie) => (
                  <label class="flex items-center gap-2 px-3 py-2 border border-slate-300 rounded-lg cursor-pointer hover:bg-slate-50 transition-colors">
                    <input type="checkbox" checked={specie !== 'Agricultura'} class="rounded border-slate-300 text-gold-700 especie-check" />
                    <span class="text-sm text-slate-700">{specie}</span>
                  </label>
                ))}
              </div>
              <p class="text-xs text-slate-400 mt-1">Selecciona las especies que produces y comercializas. Aparecerán como tags en tu perfil público.</p>
            </div>

            <!-- Rating config -->
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Calificación promedio</label>
                <div class="flex items-center gap-2">
                  <input
                    id="rating"
                    type="number"
                    step="0.1"
                    min="1"
                    max="5"
                    value="4.8"
                    class="w-24 px-3 py-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-gold-500 input-sync"
                    data-preview="preview-rating"
                  />
                  <svg class="w-5 h-5 text-amber-400" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
                  </svg>
                </div>
              </div>
              <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Ventas verificadas</label>
                <input
                  id="ventas"
                  type="number"
                  min="0"
                  value="12"
                  class="w-24 px-3 py-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-gold-500 input-sync"
                  data-preview="preview-ventas"
                />
              </div>
            </div>

            <div class="pt-4 flex gap-3">
              <button
                type="submit"
                class="px-6 py-2.5 bg-campo-600 text-white font-semibold rounded-lg hover:bg-campo-700 transition-colors"
              >
                Guardar Cambios
              </button>
              <button
                type="button"
                id="btn-reset"
                class="px-6 py-2.5 border border-slate-300 text-slate-700 font-semibold rounded-lg hover:bg-slate-50 transition-colors"
              >
                Restablecer
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  function syncPreviews() {
    const nombre = (document.getElementById('nombre-hacienda') as HTMLInputElement)?.value || 'Hacienda';
    document.getElementById('preview-nombre').textContent = nombre;

    const dep = (document.getElementById('departamento') as HTMLSelectElement)?.value || '';
    const mun = (document.getElementById('municipio') as HTMLInputElement)?.value || '';
    document.getElementById('preview-ubicacion').textContent = `${mun}, ${dep}`;

    const rating = (document.getElementById('rating') as HTMLInputElement)?.value || '4.8';
    document.getElementById('preview-rating').textContent = rating;

    const ventas = (document.getElementById('ventas') as HTMLInputElement)?.value || '0';
    document.getElementById('preview-ventas').textContent = ventas;

    const inicial = nombre.trim()[0]?.toUpperCase() || 'H';
    document.getElementById('foto-inicial').textContent = inicial;

    const slug = nombre.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '');
    const urlPreview = document.getElementById('preview-url') as HTMLAnchorElement;
    const urlText = document.getElementById('url-preview');
    urlPreview.href = `/hacienda/${slug}`;
    urlPreview.textContent = `/hacienda/${slug}`;
    if (urlText) urlText.textContent = `/hacienda/${slug}`;
  }

  // Sync on input
  document.querySelectorAll('.input-sync').forEach(el => {
    el.addEventListener('input', syncPreviews);
    el.addEventListener('change', syncPreviews);
  });

  // Logo URL preview
  const logoUrl = document.getElementById('logo-url') as HTMLInputElement;
  logoUrl?.addEventListener('input', () => {
    const preview = document.getElementById('logo-upload-preview');
    const placeholder = document.getElementById('logo-placeholder');
    if (logoUrl.value) {
      preview.innerHTML = `<img src="${logoUrl.value}" alt="Logo" class="w-full h-full object-cover" />`;
    } else {
      preview.innerHTML = '<span class="text-2xl font-bold text-slate-400" id="logo-placeholder">+</span>';
    }
  });

  // File upload
  const logoFile = document.getElementById('logo-file') as HTMLInputElement;
  logoFile?.addEventListener('change', () => {
    const file = logoFile.files?.[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = (e) => {
        const preview = document.getElementById('logo-upload-preview');
        preview.innerHTML = `<img src="${e.target?.result}" alt="Logo" class="w-full h-full object-cover" />`;
        logoUrl.value = e.target?.result as string;
      };
      reader.readAsDataURL(file);
    }
  });

  // Save to localStorage
  const form = document.getElementById('perfil-form');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = {
      nombre: (document.getElementById('nombre-hacienda') as HTMLInputElement)?.value || '',
      departamento: (document.getElementById('departamento') as HTMLSelectElement)?.value || '',
      municipio: (document.getElementById('municipio') as HTMLInputElement)?.value || '',
      whatsapp: (document.getElementById('whatsapp') as HTMLInputElement)?.value || '',
      descripcion: (document.getElementById('descripcion') as HTMLTextAreaElement)?.value || '',
      logo: logoUrl?.value || '',
      portada: (document.getElementById('portada-url') as HTMLInputElement)?.value || '',
      rating: (document.getElementById('rating') as HTMLInputElement)?.value || '4.8',
      ventas: (document.getElementById('ventas') as HTMLInputElement)?.value || '0',
      miembroDesde: 'marzo 2026',
      especies: Array.from(document.querySelectorAll('.especie-check:checked')).map((cb: any) => cb.nextElementSibling?.textContent?.trim() || ''),
    };
    localStorage.setItem('agrotech_hacienda_perfil', JSON.stringify(data));

    const btn = e.currentTarget?.querySelector('button[type="submit"]');
    if (btn) {
      const orig = btn.textContent;
      btn.textContent = '¡Guardado!';
      setTimeout(() => { btn.textContent = orig; }, 2000);
    }
  });

  // Reset
  document.getElementById('btn-reset')?.addEventListener('click', () => {
    localStorage.removeItem('agrotech_hacienda_perfil');
    location.reload();
  });

  // Load saved data
  const saved = JSON.parse(localStorage.getItem('agrotech_hacienda_perfil') || '{}');
  if (saved.nombre) {
    (document.getElementById('nombre-hacienda') as HTMLInputElement).value = saved.nombre;
    (document.getElementById('departamento') as HTMLSelectElement).value = saved.departamento || 'Caldas';
    (document.getElementById('municipio') as HTMLInputElement).value = saved.municipio || '';
    (document.getElementById('whatsapp') as HTMLInputElement).value = saved.whatsapp || '';
    (document.getElementById('descripcion') as HTMLTextAreaElement).value = saved.descripcion || '';
    (document.getElementById('rating') as HTMLInputElement).value = saved.rating || '4.8';
    (document.getElementById('ventas') as HTMLInputElement).value = saved.ventas || '0';
    (document.getElementById('logo-url') as HTMLInputElement).value = saved.logo || '';
    (document.getElementById('portada-url') as HTMLInputElement).value = saved.portada || '';

    if (saved.logo) {
      const preview = document.getElementById('logo-upload-preview');
      preview.innerHTML = `<img src="${saved.logo}" alt="Logo" class="w-full h-full object-cover" />`;
    }

    if (saved.especies) {
      document.querySelectorAll('.especie-check').forEach((cb: HTMLInputElement) => {
        const label = (cb.nextElementSibling as HTMLElement)?.textContent?.trim() || '';
        cb.checked = saved.especies.includes(label);
      });
    }
  }
  syncPreviews();
</script>
