            </div>
          </div>
        </div>
        <div class="flex flex-1 justify-between sm:hidden items-center font-sans">
          ${productosPage > 1 ? `<button data-page="${productosPage - 1}" class="relative inline-flex items-center rounded-xl border border-[#E8E0D8] bg-white px-3.5 py-2 text-sm font-bold text-[#2D2D2D] hover:bg-[#F5F0E8] transition-all">Anterior</button>` : '<div />'}
          <span class="text-sm text-[#6B6B6B] font-semibold">Página ${productosPage} de ${productosTotalPages}</span>
          ${productosPage < productosTotalPages ? `<button data-page="${productosPage + 1}" class="relative inline-flex items-center rounded-xl border border-[#E8E0D8] bg-white px-3.5 py-2 text-sm font-bold text-[#2D2D2D] hover:bg-[#F5F0E8] transition-all">Siguiente</button>` : '<div />'}
        </div>
