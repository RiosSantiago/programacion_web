        <div class="hidden sm:flex sm:flex-1 sm:items-center sm:justify-between">
          <div>
            <p class="text-sm text-[#6B6B6B] font-sans">
              Mostrando <span class="font-bold text-campo-700">${startIdx + 1}</span> a <span class="font-bold text-campo-700">${endIdx}</span> de{' '}
              <span class="font-bold text-campo-700">${productosTotal}</span> productos
            </p>
          </div>
          <div>
            <div class="inline-flex -space-x-px rounded-xl gap-1.5">
              ${prevBtn}
