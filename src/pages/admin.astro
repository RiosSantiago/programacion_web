  let productosTransporte = [];

  async function cargarTransporte() {
    try {
      // Excepción: esta tabla y el export CSV necesitan el listado completo para
      // filtrar transporte === 'agroup'. El backend no soporta "todos" de forma
      // explícita y limita `limit` a 100 (máximo por página), así que se pide ese
      // máximo en lugar de paginar con offset.
      const res = await fetch('/api/productos?limit=100');
      const data = await res.json();
      const productos = data.productos || [];
      productosTransporte = productos.filter(p => p.transporte === 'agroup');

      document.getElementById('transporte-count').textContent = `${productosTransporte.length} productos`;
      const tbody = document.getElementById('transporte-tbody');

      if (productosTransporte.length === 0) {
        tbody.innerHTML = '<tr><td colspan="8" class="text-center py-10 text-[#6B6B6B]">No hay productos que AgroUp deba transportar</td></tr>';
        return;
      }

      tbody.innerHTML = productosTransporte.map(p => `
        <tr>
          <td class="px-6 py-3 text-[#6B6B6B]">${p.id}</td>
          <td class="px-6 py-3 font-medium text-[#1A0E08]">${escapeHtml(p.nombre)}</td>
          <td class="px-6 py-3 text-[#6B6B6B]">${escapeHtml(p.vendedor)}</td>
          <td class="px-6 py-3 text-[#6B6B6B] capitalize">${escapeHtml(p.categoria)}</td>
          <td class="px-6 py-3 text-[#6B6B6B]">${escapeHtml([p.ubicacion, p.departamento].filter(Boolean).join(', ') || '—')}</td>
          <td class="px-6 py-3 text-[#1A0E08] font-medium">$${(p.precio || 0).toLocaleString('es-CO')}</td>
          <td class="px-6 py-3">
            <span class="capitalize text-xs ${p.estado === 'disponible' ? 'bg-campo-100 text-campo-700' : p.estado === 'vendido' ? 'bg-[#F5F0E8] text-[#6B6B6B]' : 'bg-gold-100 text-gold-800'} px-2 py-0.5 rounded-full">${p.estado || 'disponible'}</span>
          </td>
          <td class="px-6 py-3">
            <a href="/marketplace/${p.id}" class="text-gold-700 hover:underline text-xs">Ver</a>
          </td>
        </tr>
      `).join('');
    } catch {}
  }

  function exportarTransporteCSV() {
    if (productosTransporte.length === 0) return;
    const enc = (v) => '"' + String(v == null ? '' : v).replace(/"/g, '""') + '"';
    const header = ['ID', 'Producto', 'Vendedor', 'Categoría', 'Ubicación', 'Departamento', 'Precio', 'Estado', 'Enlace'].join(';');
    const rows = productosTransporte.map(p => [
      p.id, p.nombre, p.vendedor, p.categoria,
      p.ubicacion || '', p.departamento || '', p.precio || 0, p.estado || 'disponible',
      `https://agroup.app/marketplace/${p.id}`
    ].map(enc).join(';'));
    const csv = '\uFEFF' + [header, ...rows].join('\r\n');
    const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `agroup-transporte-${new Date().toISOString().slice(0, 10)}.csv`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }
  document.getElementById('exportar-transporte-btn').addEventListener('click', exportarTransporteCSV);

