---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FilterPanel from '../../components/marketplace/FilterPanel';
import ProductCard from '../../components/ProductCard.astro';
import EmptyState from '../../components/marketplace/EmptyState';
import '../../lib/db';
import { filtrarProductos, getTotalProductos } from '../../lib/models/productos.js';

const { searchParams } = Astro.url;
const categoria = searchParams.get('categoria') || 'todos';
const municipio = searchParams.get('municipio') || '';
const departamento = searchParams.get('departamento') || '';
const precioMin = searchParams.get('precio_min');
const precioMax = searchParams.get('precio_max');
const busqueda = searchParams.get('q') || '';
const raza = searchParams.get('raza') || '';
const sexo = searchParams.get('sexo') || '';
const tipoPrecio = searchParams.get('tipo_precio') || '';
const trazabilidad = searchParams.get('trazabilidad') || '';
const fechaPublicacion = searchParams.get('fecha_publicacion') || '';
const destacados = searchParams.get('destacados') || '';
const sortBy = searchParams.get('sort') || 'relevancia';

const filtrados = await filtrarProductos({
  categoria,
  municipio,
  departamento,
  precioMin: precioMin ? Number(precioMin) : undefined,
  precioMax: precioMax ? Number(precioMax) : undefined,
  busqueda,
  raza: raza || undefined,
  sexo: sexo || undefined,
  tipoPrecio: tipoPrecio || undefined,
  trazabilidad: trazabilidad || undefined,
  destacados: destacados || undefined,
  fechaPublicacion: fechaPublicacion || undefined,
  sortBy: sortBy || undefined,
});

const total = await getTotalProductos();

// Generar datos de reputación aleatorios para demo
const getReputacion = (vendedor: string) => {
  const hash = vendedor.split('').reduce((acc, char) => acc + char.charCodeAt(0), 0);
  const rating = 4.0 + (hash % 15) / 10;
  const ventas = 5 + (hash % 200);
  const badge = ventas > 100 ? 'top' : ventas > 20 ? 'verificado' : 'nuevo';
  return { rating: Math.round(rating * 10) / 10, ventas, badge };
};

const productosConReputacion = filtrados.map(p => {
  const rep = getReputacion(p.vendedor || 'Vendedor Demo');
  return {
    ...p,
    vendedorRating: rep.rating,
    vendedorVentas: rep.ventas,
    vendedorBadge: rep.badge,
  };
});

// Paginación
const pageParam = searchParams.get('page') || searchParams.get('pagina') || '1';
const page = Math.max(1, parseInt(pageParam) || 1);
const limit = 20;
const totalProductosFiltrados = productosConReputacion.length;
const totalPages = Math.ceil(totalProductosFiltrados / limit);
const startIdx = (page - 1) * limit;
const endIdx = startIdx + limit;
const productosPaginados = productosConReputacion.slice(startIdx, endIdx);

const currentUrl = Astro.url;
function getPageUrl(pageNum: number) {
  const params = new URLSearchParams(searchParams);
  params.set('page', pageNum.toString());
  return `${currentUrl.pathname}?${params.toString()}`;
}

const filtrosActivos = categoria !== 'todos' || municipio || raza || sexo || tipoPrecio || trazabilidad || fechaPublicacion || destacados || busqueda || precioMin || precioMax;

const sortLabelsMap: Record<string, string> = {
  'relevancia': 'Más relevantes',
  'precio-asc': 'Menor precio',
  'precio-desc': 'Mayor precio',
  'recientes': 'Más recientes',
};
const sortLabel = sortLabelsMap[sortBy] || 'Más relevantes';
---

<BaseLayout navVariant="market">
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header con título y controles -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
      <div>
        <h2 class="text-xl font-display font-bold text-stone-800">
          {categoria && categoria !== 'todos'
            ? categoria.split(',').map(c => c.charAt(0).toUpperCase() + c.slice(1)).join(', ')
            : 'Todos los productos'}
        </h2>
        <p class="text-sm text-stone-500 mt-1">
          <span class="font-semibold text-campo-700" id="total-resultados">{productosConReputacion.length}</span> 
          {productosConReputacion.length === 1 ? 'producto encontrado' : 'productos encontrados'}
          {municipio && <span> en <span class="font-semibold">{municipio.replace(/,/g, ', ')}</span></span>}
        </p>
      </div>
      <div class="flex items-center gap-3">
        <button
          type="button"
          id="btn-toggle-filters"
          onclick="toggleFiltersPanel(event)"
          class="inline-flex items-center gap-2 px-4 py-2.5 bg-white border border-[#E8DCCB] rounded-xl text-sm font-semibold text-stone-700 hover:text-campo-700 hover:border-campo-400 focus:outline-none transition-all duration-200 cursor-pointer shadow-sm"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
          </svg>
          <span>Filtros</span>
          <svg id="filters-arrow" class="w-4 h-4 text-campo-600 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div class="relative inline-block" id="sort-dropdown-container">
          <button
            type="button"
            onclick="toggleSortMenu(event)"
            class="inline-flex items-center justify-between w-48 px-4 py-2.5 bg-white border border-[#E8DCCB] rounded-xl text-sm font-semibold text-stone-700 hover:text-campo-700 hover:border-campo-400 focus:outline-none transition-all duration-200 cursor-pointer shadow-sm"
          >
            <span id="sort-current-label">{sortLabel}</span>
            <svg id="sort-dropdown-arrow" class="w-4 h-4 ml-2 text-campo-600 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div
            id="sort-dropdown-menu"
            style="display:none; position:absolute; right:0; top:calc(100% + 6px); z-index:9999; min-width:192px;"
            class="bg-white border border-stone-200 rounded-xl shadow-2xl py-1"
          >
            <button onclick="applySort('relevancia')" class="w-full text-left px-4 py-2.5 text-sm text-stone-700 hover:bg-[#f0faf3] hover:text-campo-700 transition-colors font-medium cursor-pointer">Más relevantes</button>
            <button onclick="applySort('precio-asc')" class="w-full text-left px-4 py-2.5 text-sm text-stone-700 hover:bg-[#f0faf3] hover:text-campo-700 transition-colors font-medium cursor-pointer">Menor precio</button>
            <button onclick="applySort('precio-desc')" class="w-full text-left px-4 py-2.5 text-sm text-stone-700 hover:bg-[#f0faf3] hover:text-campo-700 transition-colors font-medium cursor-pointer">Mayor precio</button>
            <button onclick="applySort('recientes')" class="w-full text-left px-4 py-2.5 text-sm text-stone-700 hover:bg-[#f0faf3] hover:text-campo-700 transition-colors font-medium cursor-pointer">Más recientes</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Panel de filtros colapsable -->
    <div id="filters-panel" class="hidden mb-8 bg-coffee-100 border border-coffee-200 rounded-2xl shadow-sm overflow-hidden">
      <FilterPanel
        client:load
        initialCategoria={categoria}
        initialMunicipio={municipio}
        initialPrecioMin={precioMin || ''}
        initialPrecioMax={precioMax || ''}
        initialRaza={raza}
        initialSexo={sexo}
        initialTipoPrecio={tipoPrecio}
        initialTrazabilidad={trazabilidad}
        initialFechaPublicacion={fechaPublicacion}
        initialDestacados={destacados}
      />
    </div>

    <!-- Grid de productos -->
    <div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-6 md:gap-8" id="productos-grid">
          {productosPaginados.map((producto) => (
            <ProductCard producto={producto} />
          ))}
        </div>

        {/* Paginación - Controles */}
        {totalPages > 1 && (
          <nav class="flex items-center justify-between border-t border-[#E8DCCB] px-4 py-3 sm:px-6 mt-12 bg-white rounded-2xl shadow-[0_4px_20px_rgba(0,0,0,0.02)]" aria-label="Pagination">
            <div class="hidden sm:flex sm:flex-1 sm:items-center sm:justify-between">
              <div>
                <p class="text-sm text-stone-600 font-sans">
                  Mostrando <span class="font-bold text-campo-700">{startIdx + 1}</span> a <span class="font-bold text-campo-700">{Math.min(endIdx, totalProductosFiltrados)}</span> de{' '}
                  <span class="font-bold text-campo-700">{totalProductosFiltrados}</span> resultados
                </p>
              </div>
              <div>
                <div class="inline-flex -space-x-px rounded-xl gap-1.5" aria-label="Pagination">
                  {page > 1 && (
                    <a
                      href={getPageUrl(page - 1)}
                      class="relative inline-flex items-center rounded-xl px-3 py-2 text-stone-600 hover:text-campo-700 hover:bg-[#f0faf3] border border-[#E8DCCB] hover:border-campo-350 transition-all duration-200 text-sm font-semibold font-sans"
                    >
                      <svg class="h-4 w-4 mr-1" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 01-.02 1.06L8.83 10l3.94 3.71a.75.75 0 11-1.04 1.08l-4.5-4.25a.75.75 0 010-1.08l4.5-4.25a.75.75 0 011.06.02z" clip-rule="evenodd" />
                      </svg>
                      Anterior
                    </a>
                  )}
                  
                  {Array.from({ length: totalPages }, (_, i) => i + 1).map((pageNum) => {
                    const isCurrent = pageNum === page;
                    return (
                      <a
                        href={getPageUrl(pageNum)}
                        class={`relative inline-flex items-center rounded-xl px-3.5 py-2 text-sm font-bold transition-all duration-200 font-sans ${
                          isCurrent
                            ? 'bg-campo-600 text-white shadow-md shadow-campo-600/15 border border-campo-600'
                            : 'text-stone-700 hover:text-campo-700 hover:bg-[#f0faf3] border border-[#E8DCCB] hover:border-campo-300'
                        }`}
                      >
                        {pageNum}
                      </a>
                    );
                  })}

                  {page < totalPages && (
                    <a
                      href={getPageUrl(page + 1)}
                      class="relative inline-flex items-center rounded-xl px-3 py-2 text-stone-600 hover:text-campo-700 hover:bg-[#f0faf3] border border-[#E8DCCB] hover:border-campo-350 transition-all duration-200 text-sm font-semibold font-sans"
                    >
                      Siguiente
                      <svg class="h-4 w-4 ml-1" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.17 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
                      </svg>
                    </a>
                  )}
                </div>
              </div>
            </div>
            
            {/* Mobile version */}
            <div class="flex flex-1 justify-between sm:hidden items-center font-sans">
              {page > 1 ? (
                <a
                  href={getPageUrl(page - 1)}
                  class="relative inline-flex items-center rounded-xl border border-[#E8DCCB] bg-white px-3.5 py-2 text-sm font-bold text-stone-700 hover:bg-stone-50 transition-all"
                >
                  Anterior
                </a>
              ) : (
                <div />
              )}
              <span class="text-sm text-stone-500 font-semibold">Página {page} de {totalPages}</span>
              {page < totalPages ? (
                <a
                  href={getPageUrl(page + 1)}
                  class="relative inline-flex items-center rounded-xl border border-[#E8DCCB] bg-white px-3.5 py-2 text-sm font-bold text-stone-700 hover:bg-stone-50 transition-all"
                >
                  Siguiente
                </a>
              ) : (
                <div />
              )}
            </div>
          </nav>
        )}

        <!-- Estado vacío con animación Lottie -->
        <div id="no-resultados" style={{ display: productosConReputacion.length === 0 ? 'block' : 'none' }}>
          {filtrosActivos ? (
            <EmptyState client:load filtrosActivos={filtrosActivos} />
          ) : (
            <div class="py-16 text-center">
              <div class="mx-auto w-[180px] h-[180px] mb-4 opacity-60">
                <img src="/cow-head-animated.svg" alt="" class="w-full h-full" />
              </div>
              <h3 class="text-xl font-display font-bold text-stone-800 mb-2">
                No hay productos disponibles
              </h3>
              <p class="text-stone-500 text-sm">
                Actualmente no hay productos publicados en el marketplace.
              </p>
            </div>
          )}
        </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  // Dropdown de ordenamiento — debe ser is:inline para que onclick="" lo encuentre
  function toggleSortMenu(e) {
    e.stopPropagation();
    var menu = document.getElementById('sort-dropdown-menu');
    var arrow = document.getElementById('sort-dropdown-arrow');
    if (!menu) return;
    var isOpen = menu.style.display === 'block';
    menu.style.display = isOpen ? 'none' : 'block';
    if (arrow) arrow.style.transform = isOpen ? '' : 'rotate(180deg)';
  }

  function applySort(val) {
    var params = new URLSearchParams(window.location.search);
    if (val && val !== 'relevancia') params.set('sort', val);
    else params.delete('sort');
    params.delete('page');
    params.delete('pagina');
    window.location.href = '/marketplace?' + params.toString();
  }

  function toggleFiltersPanel(e) {
    e.stopPropagation();
    var panel = document.getElementById('filters-panel');
    var arrow = document.getElementById('filters-arrow');
    if (!panel) return;
    var isOpen = !panel.classList.contains('hidden');
    panel.classList.toggle('hidden');
    if (arrow) arrow.style.transform = isOpen ? '' : 'rotate(180deg)';
  }

  document.addEventListener('click', function(e) {
    var container = document.getElementById('sort-dropdown-container');
    if (container && !container.contains(e.target)) {
      var menu = document.getElementById('sort-dropdown-menu');
      var arrow = document.getElementById('sort-dropdown-arrow');
      if (menu) menu.style.display = 'none';
      if (arrow) arrow.style.transform = '';
    }
    var btn = document.getElementById('btn-toggle-filters');
    var panel = document.getElementById('filters-panel');
    if (panel && !panel.classList.contains('hidden') && btn && !btn.contains(e.target) && !panel.contains(e.target)) {
      panel.classList.add('hidden');
      var fArrow = document.getElementById('filters-arrow');
      if (fArrow) fArrow.style.transform = '';
    }
  });
</script>

<script>
  // Marcar opción activa del sort según URL
  const sortLabels: Record<string, string> = {
    'relevancia': 'Más relevantes',
    'precio-asc': 'Menor precio',
    'precio-desc': 'Mayor precio',
    'recientes': 'Más recientes'
  };
  const currentSort = new URLSearchParams(window.location.search).get('sort') || 'relevancia';
  const labelEl = document.getElementById('sort-current-label');
  if (labelEl) labelEl.textContent = sortLabels[currentSort] || 'Más relevantes';
</script>

<style>
  .empty-state-btn {
    background-color: #2D6A4F;
    color: #ffffff;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 4px 6px -1px rgba(45, 106, 79, 0.2), 0 2px 4px -1px rgba(45, 106, 79, 0.1);
  }

  .empty-state-btn:hover {
    background-color: #1B4332;
    transform: translateY(-2px);
    box-shadow: 0 10px 15px -3px rgba(27, 67, 50, 0.3), 0 4px 6px -2px rgba(27, 67, 50, 0.15);
  }

  .empty-state-btn:active {
    transform: translateY(0) scale(0.98);
  }
</style>
