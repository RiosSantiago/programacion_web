---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FilterPanel from '../../components/marketplace/FilterPanel.tsx';
import ProductCard from '../../components/ProductCard.astro';
import '../../lib/db';
import { filtrarProductos, getTotalProductos } from '../../lib/models/productos.js';

const { searchParams } = Astro.url;
const categoria = searchParams.get('categoria') || 'todos';
const municipio = searchParams.get('municipio') || '';
const departamento = searchParams.get('departamento') || '';
const precioMin = searchParams.get('precio_min');
const precioMax = searchParams.get('precio_max');
const busqueda = searchParams.get('q') || '';
const raza = searchParams.get('raza') || '';
const sexo = searchParams.get('sexo') || '';
const tipoPrecio = searchParams.get('tipo_precio') || '';
const trazabilidad = searchParams.get('trazabilidad') || '';
const fechaPublicacion = searchParams.get('fecha_publicacion') || '';
const destacados = searchParams.get('destacados') || '';
const sortBy = searchParams.get('sort') || 'relevancia';

const filtrados = filtrarProductos({
  categoria,
  municipio,
  departamento,
  precioMin: precioMin ? Number(precioMin) : undefined,
  precioMax: precioMax ? Number(precioMax) : undefined,
  busqueda,
  raza: raza || undefined,
  sexo: sexo || undefined,
  tipoPrecio: tipoPrecio || undefined,
  trazabilidad: trazabilidad || undefined,
  destacados: destacados || undefined,
  fechaPublicacion: fechaPublicacion || undefined,
  sortBy: sortBy || undefined,
});

const total = getTotalProductos();

// Generar datos de reputación aleatorios para demo
const getReputacion = (vendedor: string) => {
  const hash = vendedor.split('').reduce((acc, char) => acc + char.charCodeAt(0), 0);
  const rating = 4.0 + (hash % 15) / 10;
  const ventas = 5 + (hash % 200);
  const badge = ventas > 100 ? 'top' : ventas > 20 ? 'verificado' : 'nuevo';
  return { rating: Math.round(rating * 10) / 10, ventas, badge };
};

const productosConReputacion = filtrados.map(p => {
  const rep = getReputacion(p.vendedor || 'Vendedor Demo');
  return {
    ...p,
    vendedorRating: rep.rating,
    vendedorVentas: rep.ventas,
    vendedorBadge: rep.badge,
  };
});
---

<BaseLayout navVariant="market">
  <!-- Panel de filtros (sticky debajo del Navbar) -->
  <div class="sticky top-[64px] z-30 shadow-sm bg-[#1F4628]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <FilterPanel
        client:load
        initialCategoria={categoria}
        initialMunicipio={municipio}
        initialPrecioMin={precioMin || ''}
        initialPrecioMax={precioMax || ''}
        initialRaza={raza}
        initialSexo={sexo}
        initialTipoPrecio={tipoPrecio}
        initialTrazabilidad={trazabilidad}
        initialFechaPublicacion={fechaPublicacion}
        initialDestacados={destacados}
      />
    </div>
  </div>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header con título y controles -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
      <div>
        <h2 class="text-xl font-display font-bold text-stone-800">
          {categoria && categoria !== 'todos'
            ? categoria.split(',').map(c => c.charAt(0).toUpperCase() + c.slice(1)).join(', ')
            : 'Todos los productos'}
        </h2>
        <p class="text-sm text-stone-500 mt-1">
          <span class="font-semibold text-campo-700" id="total-resultados">{productosConReputacion.length}</span> 
          {productosConReputacion.length === 1 ? 'producto encontrado' : 'productos encontrados'}
          {municipio && <span> en <span class="font-semibold">{municipio.replace(/,/g, ', ')}</span></span>}
        </p>
      </div>
      <div class="flex items-center gap-3">
        <div class="relative">
          <select
            id="sort-select"
            class="appearance-none pl-4 pr-10 py-2.5 bg-white border border-[#E8E0D8] rounded-xl text-sm font-medium text-[#6B6B6B] focus:border-orange-500 focus:ring-2 focus:ring-orange-100 transition-all cursor-pointer hover:border-orange-400"
          >
            <option value="relevancia">Más relevantes</option>
            <option value="precio-asc">Menor precio</option>
            <option value="precio-desc">Mayor precio</option>
            <option value="recientes">Más recientes</option>
          </select>
          <svg class="absolute right-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </div>
      </div>
    </div>

    <!-- Grid de productos -->
    <div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 md:gap-4" id="productos-grid">
          {productosConReputacion.map((producto) => (
            <ProductCard producto={producto} />
          ))}
        </div>

        <!-- Estado vacío -->
        <div id="no-resultados" class="text-center py-20" style={{ display: productosConReputacion.length === 0 ? 'block' : 'none' }}>
          <div class="w-20 h-20 bg-stone-100 rounded-2xl flex items-center justify-center mx-auto mb-6">
            <svg class="w-10 h-10 text-stone-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
            </svg>
          </div>
          <h3 class="text-lg font-display font-bold text-stone-700 mb-2">No se encontraron productos</h3>
          <p class="text-sm text-stone-500 mb-6">Intenta ajustar los filtros o buscar otro término</p>
          <a href="/marketplace" class="btn-primary inline-flex">Ver todos los productos</a>
      </div>
    </div>
  </section>

  <!-- Mobile Filter Drawer -->
  <div id="mobile-filter-overlay" class="fixed inset-0 bg-black/50 z-40 hidden backdrop-blur-sm lg:hidden" onclick="cerrarMobileFilter()"></div>

  <!-- Modal para productos locales (solo localStorage) -->
  <div id="local-product-modal" class="hidden fixed inset-0 z-50">
    <div class="absolute inset-0 bg-black/50" onclick="cerrarLocalModal()"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-lg bg-white rounded-2xl p-6 max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-display font-bold text-stone-800">Detalles del Producto</h3>
        <button onclick="cerrarLocalModal()" class="p-1 hover:bg-stone-100 rounded">
          <svg class="w-5 h-5 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <div id="local-modal-content" class="space-y-4"></div>
    </div>
  </div>
  <div id="mobile-filter-drawer" class="fixed top-0 left-0 h-full w-80 bg-white shadow-2xl z-50 transform -translate-x-full transition-transform duration-300 overflow-y-auto lg:hidden">
    <div class="flex items-center justify-between p-5 border-b border-[#E8E0D8] bg-gradient-to-r from-campo-700 to-campo-800">
      <h3 class="text-lg font-display font-bold text-white">Filtros</h3>
      <button onclick="cerrarMobileFilter()" class="w-10 h-10 flex items-center justify-center rounded-xl text-orange-300 hover:bg-campo-600 hover:text-white transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    <div class="p-5">
      <FilterPanel client:load initialCategoria={categoria} initialMunicipio={municipio} initialPrecioMin={precioMin || ''} initialPrecioMax={precioMax || ''} initialRaza={raza} initialSexo={sexo} initialTipoPrecio={tipoPrecio} initialTrazabilidad={trazabilidad} initialFechaPublicacion={fechaPublicacion} initialDestacados={destacados} />
    </div>
  </div>
</BaseLayout>

<script>
  function cerrarLocalModal() {
    document.getElementById('local-product-modal')?.classList.add('hidden');
    document.body.style.overflow = '';
  }
  (window as any).cerrarLocalModal = cerrarLocalModal;
  (window as any).abrirLocalModal = function(idx: number) {
    const p = (window as any).__localProductos?.[idx];
    if (!p) return;
    const img = p.imagenes?.[0] || '/images/ganado.svg';
    const content = document.getElementById('local-modal-content');
    if (!content) return;
    content.innerHTML = `
      <div class="flex gap-4">
        <div class="w-24 h-24 bg-stone-100 rounded-xl shrink-0 overflow-hidden">
          <img src="${img}" alt="${p.nombre}" class="w-full h-full object-cover" />
        </div>
        <div class="flex-1">
          <h4 class="text-xl font-display font-bold text-stone-800">${p.nombre}</h4>
          <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-bold bg-campo-700 text-white mt-1">Nuevo</span>
        </div>
      </div>
      <div class="grid grid-cols-2 gap-3 text-sm">
        <div class="bg-stone-50 rounded-lg p-3">
          <p class="text-stone-500">Precio</p>
          <p class="font-bold text-stone-800 text-lg">$${parseInt(p.precio || 0).toLocaleString('es-CO')}</p>
        </div>
        <div class="bg-stone-50 rounded-lg p-3">
          <p class="text-stone-500">Categoria</p>
          <p class="font-semibold text-stone-700 capitalize">${p.categoria || '—'}</p>
        </div>
        <div class="bg-stone-50 rounded-lg p-3">
          <p class="text-stone-500">Ubicacion</p>
          <p class="font-semibold text-stone-700">${p.ubicacion || '—'}</p>
        </div>
        <div class="bg-stone-50 rounded-lg p-3">
          <p class="text-stone-500">Stock</p>
          <p class="font-semibold text-stone-700">${p.stock || 1} cabezas</p>
        </div>
      </div>
      ${p.descripcion ? `<div class="bg-stone-50 rounded-lg p-3 text-sm"><p class="text-stone-500">Descripcion</p><p class="text-stone-700">${p.descripcion}</p></div>` : ''}
      <div class="flex gap-2">
        <button onclick="window.open('https://wa.me/573001234567?text=' + encodeURIComponent('Hola, me interesa: ${p.nombre}'), '_blank')" class="flex-1 py-2.5 bg-campo-700 text-white font-bold rounded-lg hover:bg-campo-800 text-sm transition-all">Contactar por WhatsApp</button>
        <button onclick="cerrarLocalModal()" class="px-4 py-2.5 border border-stone-300 text-stone-700 font-semibold rounded-lg hover:bg-stone-50 text-sm transition-all">Cerrar</button>
      </div>
    `;
    document.getElementById('local-product-modal')?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  (window as any).cerrarMobileFilter = function() {
    document.getElementById('mobile-filter-overlay')?.classList.add('hidden');
    document.getElementById('mobile-filter-drawer')?.classList.add('-translate-x-full');
    document.body.style.overflow = '';
  };

  const sortSelect = document.getElementById('sort-select') as HTMLSelectElement;
  const paramsSort = new URLSearchParams(window.location.search);
  const currentSort = paramsSort.get('sort') || 'relevancia';
  if (sortSelect) sortSelect.value = currentSort;

  sortSelect?.addEventListener('change', (e: any) => {
    const params = new URLSearchParams(window.location.search);
    const val = e.target.value;
    if (val && val !== 'relevancia') params.set('sort', val);
    else params.delete('sort');
    window.location.href = '/marketplace?' + params.toString();
  });

  document.getElementById('mobile-filter-btn')?.addEventListener('click', () => {
    document.getElementById('mobile-filter-overlay')?.classList.remove('hidden');
    document.getElementById('mobile-filter-drawer')?.classList.remove('-translate-x-full');
    document.body.style.overflow = 'hidden';
  });

  // Cargar productos de localStorage y agregarlos al grid
  (async function() {
    try {
      const localProductos = JSON.parse(localStorage.getItem('agroup_productos') || '[]');
      (window as any).__localProductos = localProductos;
      if (localProductos.length === 0) return;

      const grid = document.getElementById('productos-grid');
      const totalEl = document.getElementById('total-resultados');
      const noResultados = document.getElementById('no-resultados');
      
      if (!grid) return;

      // Generar reputación para productos locales
      const getReputacionLocal = (nombre: string) => {
        const hash = nombre.split('').reduce((acc: number, char: string) => acc + char.charCodeAt(0), 0);
        const rating = 4.0 + (hash % 15) / 10;
        const ventas = 5 + (hash % 50);
        return { rating: Math.round(rating * 10) / 10, ventas, badge: 'nuevo' as const };
      };

      // Crear cards para productos locales
      localProductos.reverse().forEach((p: any) => {
        const rep = getReputacionLocal(p.nombre);
        const allImgs = p.imagenes?.length ? p.imagenes : ['/images/ganado.svg'];
        const imgSrc = allImgs[0];
        const multipleImgs = allImgs.length > 1;
        const pIndex = localProductos.indexOf(p);
        
        const card = document.createElement('article');
        card.className = 'card-elegante overflow-hidden group cursor-pointer';
        card.setAttribute('data-href', `/marketplace/${p.id}`);
        card.setAttribute('data-imagenes', JSON.stringify(allImgs));
        card.setAttribute('data-img-index', '0');
        card.innerHTML = `
          <div class="relative aspect-[4/3] bg-[#FAF8F3] overflow-hidden">
            <img src="${imgSrc}" alt="${p.nombre}" class="card-img w-full h-full object-contain p-3 group-hover:scale-105 transition-transform duration-500" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/15 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" />
            <div class="absolute top-2 left-2">
              <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[11px] font-bold bg-campo-600 text-white shadow-sm">
                Nuevo
              </span>
            </div>
            ${multipleImgs ? `
            <button class="card-nav-prev absolute left-1 top-1/2 -translate-y-1/2 w-6 h-6 bg-white/80 backdrop-blur-sm rounded-full flex items-center justify-center shadow-sm opacity-0 group-hover:opacity-100 transition-opacity duration-200 hover:bg-white z-10 text-[#2D2D2D]" onclick="event.stopPropagation();window.cardNav(this,-1)" aria-label="Anterior">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/></svg>
            </button>
            <button class="card-nav-next absolute right-1 top-1/2 -translate-y-1/2 w-6 h-6 bg-white/80 backdrop-blur-sm rounded-full flex items-center justify-center shadow-sm opacity-0 group-hover:opacity-100 transition-opacity duration-200 hover:bg-white z-10 text-[#2D2D2D]" onclick="event.stopPropagation();window.cardNav(this,1)" aria-label="Siguiente">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
            </button>
            <div class="absolute bottom-2 left-1/2 -translate-x-1/2 flex gap-1 z-10">
              ${allImgs.map((_, i) => `<span class="card-dot block w-1.5 h-1.5 rounded-full transition-all duration-200 ${i === 0 ? 'bg-white shadow-sm w-3' : 'bg-white/50'}" />`).join('')}
            </div>
            ` : ''}
            <div class="absolute bottom-2 right-2">
              <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-medium bg-white/80 backdrop-blur-sm text-[#6B6B6B] shadow-sm">
                ${p.stock || 1} ${p.stock === 1 ? 'ud.' : 'uds.'}
              </span>
            </div>
          </div>
          <div class="p-3 space-y-2">
            <h3 class="text-sm font-display font-bold text-[#2D2D2D] leading-tight line-clamp-1 group-hover:text-campo-700 transition-colors">${p.nombre}</h3>
            <p class="text-base font-extrabold text-[#2D2D2D]">$${parseInt(p.precio || 0).toLocaleString('es-CO')}</p>
            <div class="flex gap-1.5 pt-1">
              <button onclick="abrirLocalModal(${pIndex})" class="flex-1 inline-flex items-center justify-center gap-1 px-3 py-2 bg-[#FFFDF7] text-[#2D2D2D] font-semibold rounded-lg border border-[#E8E0D8] hover:border-campo-400 hover:bg-campo-50 active:scale-[0.98] transition-all duration-200 text-[11px] cursor-pointer">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
                Ver
              </button>
              <button class="agregar-carrito-btn flex-1 inline-flex items-center justify-center gap-1 px-3 py-2 bg-campo-600 text-white font-bold rounded-lg shadow-sm hover:bg-campo-700 active:scale-[0.98] transition-all duration-200 text-[11px]"
                data-id="${p.id}"
                data-nombre="${p.nombre}"
                data-precio="${p.precio}"
                data-imagen="${imgSrc}"
                data-vendedor="Mi Hacienda"
              >
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
                Agregar
              </button>
            </div>
          </div>
        `;
        card.addEventListener('click', (e) => {
          if (!(e.target as HTMLElement).closest('button, .agregar-carrito-btn, .card-nav-prev, .card-nav-next')) {
            window.location.href = `/marketplace/${p.id}`;
          }
        });
        
        grid.insertBefore(card, grid.firstChild);
      });

      // Actualizar total
      const totalActual = parseInt(totalEl?.textContent || '0') + localProductos.length;
      totalEl.textContent = totalActual;
      
      // Ocultar mensaje de no resultados
      if (noResultados) {
        noResultados.style.display = 'none';
      }
    } catch (e) {
      console.error('Error cargando productos locales:', e);
    }
  })();
</script>