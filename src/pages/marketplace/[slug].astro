---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PhotoCarousel from '../../components/marketplace/PhotoCarousel';
import TraceabilityBlock from '../../components/marketplace/TraceabilityBlock.tsx';
import QRTrazabilidad from '../../components/marketplace/QRTrazabilidad';
import WhatsAppButton from '../../components/marketplace/WhatsAppButton.tsx';
import '../../lib/db';
import { getProductos, getProductoById } from '../../lib/models/productos.js';

const slug = Astro.params.slug;
const producto = slug ? getProductoById(parseInt(slug)) : undefined;

const vendedorNombre = producto?.vendedor || 'Hacienda Verde';
const vendedorInicial = vendedorNombre[0] || 'H';
const vendedorRating = producto?.vendedorRating || 4.5;
const hashVendedor = vendedorNombre.split('').reduce((acc, char) => acc + char.charCodeAt(0), 0);
const ventasDemo = 5 + (hashVendedor % 200);
const badgeDemo = ventasDemo > 100 ? 'top' : ventasDemo > 20 ? 'verificado' : 'nuevo';
const categoriaIconos: Record<string, string> = {
  bovino: '/images/ganado.svg',
  equino: '/images/caballo.svg',
  porcino: '/images/cerdo.svg',
  ovino: '/images/ganado.svg',
  avicola: '/images/gallina.svg',
  agricultura: '/images/cultivos.svg',
  insumos: '/images/default.svg',
};
const iconoCategoria = categoriaIconos[producto?.categoria?.toLowerCase() || 'bovino'] || '/images/ganado.svg';
const tieneDescuento = producto?.precioAnterior && producto.precioAnterior > producto.precio;
const descuento = tieneDescuento ? Math.round((1 - producto.precio / producto.precioAnterior!) * 100) : 0;
const badgeInfo: Record<string, { label: string; class: string; icon: string }> = {
  top: { label: 'Top Vendedor', class: 'bg-gradient-to-r from-gold-400 to-gold-500 text-white shadow-sm', icon: '★' },
  verificado: { label: 'Verificado', class: 'bg-campo-600 text-white', icon: '✓' },
  nuevo: { label: 'Nuevo', class: 'bg-blue-500 text-white', icon: '◆' },
};
---

<BaseLayout>
  {
    producto ? (
    <div class="bg-gradient-to-b from-[#FFFDF7] to-[#F5F0E8] min-h-screen" data-producto-id={producto.id} data-producto-nombre={producto.nombre}>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
      <nav class="flex items-center gap-2 text-sm mb-6">
        <a href="/marketplace" class="text-[#6B6B6B] hover:text-gold-700 transition-colors font-medium">Marketplace</a>
        <svg class="w-4 h-4 text-[#C0B0A0]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
        <a href="/marketplace" class="text-[#6B6B6B] hover:text-gold-700 transition-colors font-medium">Productos</a>
        <svg class="w-4 h-4 text-[#C0B0A0]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
        <span class="text-gold-800 font-semibold">{producto.nombre}</span>
      </nav>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div class="bg-white rounded-2xl shadow-lg overflow-hidden">
          <PhotoCarousel client:load fotos={producto.imagenes || [producto.imagen || '/images/ganado.svg']} />
          {
            producto.video && (
              <div class="border-t border-[#E8E0D8]">
                <div class="p-3 border-b border-[#E8E0D8] bg-[#F5F0E8]">
                  <p class="text-xs font-semibold text-[#6B6B6B] uppercase tracking-wider">Video del animal</p>
                </div>
                <video
                  src={producto.video}
                  controls
                  class="w-full aspect-video object-cover"
                  playsinline
                >
                  Tu navegador no soporta video.
                </video>
              </div>
            )
          }
        </div>

        <div class="space-y-6">
          <div class="flex items-center gap-2 flex-wrap">
            <span class={`inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm font-bold shadow-sm ${
              producto.estado === 'reservado' ? 'bg-gold-500 text-white' :
              producto.estado === 'vendido' ? 'bg-coral-600 text-white' :
              'bg-campo-600 text-white'
            }`}>
              <span class="w-2 h-2 rounded-full bg-white animate-pulse"></span>
              {producto.estado === 'reservado' ? 'Reservado' : producto.estado === 'vendido' ? 'Vendido' : 'Disponible'}
            </span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white rounded-full text-sm font-semibold shadow-sm border border-[#E8E0D8]">
              <img src={iconoCategoria} alt="" class="w-4 h-4" />
              <span class="text-[#2D2D2D] capitalize">{producto.categoria}</span>
            </span>
            {producto.destacado && (
              <span class="inline-flex items-center gap-1 px-3 py-1.5 rounded-full text-sm font-bold bg-gradient-to-r from-gold-400 to-gold-500 text-white shadow-sm">
                ★ Destacado
              </span>
            )}
            {producto.oferta && tieneDescuento && (
              <span class="inline-flex items-center gap-1 px-3 py-1.5 rounded-full text-sm font-bold bg-coral-600 text-white shadow-sm">
                -{descuento}% Descuento
              </span>
            )}
            {producto.trazabilidad && (
              <span class="inline-flex items-center gap-1 px-3 py-1.5 rounded-full text-sm font-semibold bg-gold-100 text-gold-800">
                ✓ Con trazabilidad
              </span>
            )}
          </div>

          <div>
            <h1 class="text-2xl md:text-3xl font-extrabold text-[#1A0E08] leading-tight">
              {producto.nombre}
            </h1>
          </div>

          <div class="bg-white rounded-2xl p-5 shadow-sm border border-[#E8E0D8]">
            <div class="flex items-center gap-4">
              <div class="w-14 h-14 bg-gradient-to-br from-gold-500 to-gold-700 rounded-2xl flex items-center justify-center shadow-md">
                <span class="text-white text-2xl font-bold">{vendedorInicial}</span>
              </div>
              <div class="flex-1">
                <div class="flex items-center gap-2">
                  <h3 class="font-bold text-[#1A0E08]">{vendedorNombre}</h3>
                  <span class={`inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold ${badgeInfo[badgeDemo].class}`}>
                    {badgeInfo[badgeDemo].icon}
                    {badgeInfo[badgeDemo].label}
                  </span>
                </div>
                <div class="flex items-center gap-3 mt-1">
                  <div class="flex items-center gap-1">
                    {[...Array(5)].map((_, i) => (
                      <span class={`text-sm ${i < Math.floor(vendedorRating) ? 'text-gold-500' : 'text-[#E8E0D8]'}`}>★</span>
                    ))}
                  </div>
                  <span class="text-sm font-semibold text-[#2D2D2D]">{vendedorRating.toFixed(1)}</span>
                  <span class="text-sm text-[#6B6B6B]">({ventasDemo} ventas)</span>
                </div>
                <p class="text-xs text-[#6B6B6B] mt-1 flex items-center gap-1">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 00-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  </svg>
                  Vendedor verificado
                </p>
              </div>
            </div>
          </div>

          <div class="bg-gradient-to-r from-gold-50 to-white rounded-2xl p-6 border border-gold-200">
            <div class="flex items-end justify-between">
              <div>
                {tieneDescuento && (
                  <span class="text-lg text-[#6B6B6B] line-through">
                    ${producto.precioAnterior?.toLocaleString('es-CO')}
                  </span>
                )}
                <p class="text-4xl font-extrabold text-[#1A0E08]">
                  ${producto.precio.toLocaleString('es-CO')}
                </p>
                {producto.stock && producto.stock > 1 && (
                  <p class="text-sm text-[#6B6B6B] mt-1">
                    ≈ ${Math.round(producto.precio / producto.stock).toLocaleString('es-CO')}/unidad
                  </p>
                )}
              </div>
              <div class="text-right">
                <span class={`inline-flex items-center px-3 py-1.5 rounded-lg text-sm font-bold ${producto.stock > 1 ? 'bg-gold-100 text-gold-800' : 'bg-gold-100 text-gold-800'}`}>
                  {producto.stock || 1} {producto.stock === 1 ? 'cabeza disponible' : 'cabezas disponibles'}
                </span>
              </div>
            </div>
          </div>

          <div class="flex gap-3">
            <button
              class="agregar-carrito-btn flex-1 inline-flex items-center justify-center gap-2 px-6 py-4 bg-campo-800 text-white font-bold rounded-xl shadow-lg hover:bg-campo-700 active:scale-[0.98] transition-all duration-200 text-base"
              data-id={producto.id}
              data-nombre={producto.nombre}
              data-precio={producto.precio}
              data-imagen={producto.imagen || '/images/ganado.svg'}
              data-vendedor={vendedorNombre}
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
              Agregar al Carrito
            </button>
            <WhatsAppButton client:load nombreProducto={producto.nombre} precio={producto.precio} />
          </div>

          <div class="bg-white rounded-2xl shadow-sm border border-[#E8E0D8] p-5">
            <h3 class="font-bold text-[#1A0E08] mb-3">¿Completaste una transaccion?</h3>
            <p class="text-sm text-[#6B6B6B] mb-3">Califica al vendedor y ayuda a construir su reputacion</p>
            <div id="rating-section" class="flex items-center gap-3">
              <div class="flex items-center gap-1" id="rating-stars">
                {[1, 2, 3, 4, 5].map((star) => (
                  <button
                    class="rating-star w-8 h-8 text-[#E8E0D8] hover:text-gold-500 transition-colors"
                    data-star={star}
                  >
                    <svg class="w-full h-full" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
                    </svg>
                  </button>
                ))}
              </div>
              <span id="rating-text" class="text-sm text-[#6B6B6B]">Selecciona una puntuacion</span>
            </div>
            <div id="rating-thanks" class="hidden bg-gold-100 rounded-lg p-3 text-center">
              <p class="text-gold-800 font-semibold">Gracias por tu calificacion!</p>
              <p class="text-gold-700 text-sm mt-1">Tu opinion ayuda a la comunidad.</p>
            </div>
          </div>

          <div class="text-center">
            <button
              id="btn-reportar"
              class="inline-flex items-center gap-1.5 text-xs text-[#6B6B6B] hover:text-coral-600 transition-colors"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z" />
              </svg>
              Reportar publicacion
            </button>
          </div>

          <div id="reportar-modal" class="hidden fixed inset-0 z-50">
            <div class="absolute inset-0 bg-black/50" onclick="document.getElementById('reportar-modal').classList.add('hidden')"></div>
            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-md bg-white rounded-xl p-6">
              <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-bold text-[#1A0E08]">Reportar Publicacion</h3>
                <button onclick="document.getElementById('reportar-modal').classList.add('hidden')" class="p-1 hover:bg-[#F5F0E8] rounded">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
              </div>
              <form id="reportar-form" class="space-y-4">
                <div>
                  <label class="block text-sm font-medium text-[#2D2D2D] mb-2">Motivo del reporte</label>
                  <select id="reportar-motivo" class="w-full px-3 py-2 border border-[#E8E0D8] rounded-lg text-sm" required>
                    <option value="">Selecciona un motivo</option>
                    <option value="fraudulento">Anuncio fraudulento</option>
                    <option value="informacion_incorrecta">Informacion incorrecta</option>
                    <option value="precio_enganoso">Precio enganoso</option>
                    <option value="animal_no_corresponde">El animal no corresponde a la descripcion</option>
                    <option value="otro">Otro</option>
                  </select>
                </div>
                <div>
                  <label class="block text-sm font-medium text-[#2D2D2D] mb-2">Comentario adicional</label>
                  <textarea id="reportar-comentario" rows={3} class="w-full px-3 py-2 border border-[#E8E0D8] rounded-lg text-sm" placeholder="Describe el problema..."></textarea>
                </div>
                <button type="submit" class="w-full py-2.5 bg-coral-600 text-white font-semibold rounded-lg hover:bg-coral-700 transition-colors">
                  Enviar Reporte
                </button>
              </form>
              <div id="reportar-gracias" class="hidden text-center py-4">
                <svg class="w-12 h-12 text-campo-600 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <p class="text-[#1A0E08] font-semibold mt-2">Reporte enviado</p>
                <p class="text-sm text-[#6B6B6B] mt-1">Gracias por ayudarnos a mantener la calidad del marketplace.</p>
              </div>
            </div>
          </div>

          <div class="bg-white rounded-2xl shadow-sm border border-[#E8E0D8] overflow-hidden">
            <div class="px-5 py-4 bg-gradient-to-r from-[#F5F0E8] to-white border-b border-[#E8E0D8]">
              <h3 class="font-bold text-[#1A0E08]">Detalles del Producto</h3>
            </div>
            <div class="p-5 space-y-3">
              {producto.raza && (
                <div class="flex items-center justify-between py-2 border-b border-[#E8E0D8]">
                  <span class="text-sm text-[#6B6B6B] flex items-center gap-2">
                    <svg class="w-4 h-4 text-gold-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                    </svg>
                    Raza
                  </span>
                  <span class="font-semibold text-[#2D2D2D]">{producto.raza}</span>
                </div>
              )}
              {producto.sexo && (
                <div class="flex items-center justify-between py-2 border-b border-[#E8E0D8]">
                  <span class="text-sm text-[#6B6B6B] flex items-center gap-2">
                    <svg class="w-4 h-4 text-gold-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2" />
                      <circle cx="8.5" cy="7" r="4" />
                    </svg>
                    Sexo
                  </span>
                  <span class="font-semibold text-[#2D2D2D] capitalize">{producto.sexo}</span>
                </div>
              )}
              {producto.peso && (
                <div class="flex items-center justify-between py-2 border-b border-[#E8E0D8]">
                  <span class="text-sm text-[#6B6B6B] flex items-center gap-2">
                    <svg class="w-4 h-4 text-gold-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" />
                    </svg>
                    Peso promedio
                  </span>
                  <span class="font-semibold text-[#2D2D2D]">{producto.peso} kg</span>
                </div>
              )}
              {producto.estado && (
                <div class="flex items-center justify-between py-2 border-b border-[#E8E0D8]">
                  <span class="text-sm text-[#6B6B6B] flex items-center gap-2">
                    <svg class="w-4 h-4 text-gold-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    Estado
                  </span>
                  <span class="font-semibold text-[#2D2D2D] capitalize">{producto.estado}</span>
                </div>
              )}
              {producto.salud && (
                <div class="flex items-center justify-between py-2 border-b border-[#E8E0D8]">
                  <span class="text-sm text-[#6B6B6B] flex items-center gap-2">
                    <svg class="w-4 h-4 text-gold-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                    </svg>
                    Estado de salud
                  </span>
                  <span class="font-semibold text-[#2D2D2D]">{producto.salud}</span>
                </div>
              )}
              {producto.descripcion && (
                <div class="flex items-start justify-between py-2 border-b border-[#E8E0D8]">
                  <span class="text-sm text-[#6B6B6B] flex items-center gap-2 shrink-0">
                    <svg class="w-4 h-4 text-gold-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z" />
                    </svg>
                    Descripción
                  </span>
                  <span class="font-semibold text-[#2D2D2D] text-right max-w-[65%]">{producto.descripcion}</span>
                </div>
              )}

            </div>
          </div>

          {producto.trazabilidad && (
            <div>
              <TraceabilityBlock client:visible data={{
                pesoActual: producto.peso ?? undefined,
                ultimaVacuna: producto.salud || 'Aftosa',
                fechaNacimiento: producto.fecha_nacimiento || '2024-01',
                verificacion: producto.trazabilidad ? 'verificado' : 'basico',
                categoria: producto.categoria,
                historialPeso: [
                  { fecha: 'Ene 26', peso: Math.round((producto.peso || 400) * 0.75) },
                  { fecha: 'Feb 26', peso: Math.round((producto.peso || 400) * 0.82) },
                  { fecha: 'Mar 26', peso: Math.round((producto.peso || 400) * 0.88) },
                  { fecha: 'Abr 26', peso: Math.round((producto.peso || 400) * 0.94) },
                  { fecha: 'May 26', peso: producto.peso || 445 },
                ],
                vacunas: [
                  { fecha: '2026-01-15', nombre: 'Aftosa', tipo: 'Obligatoria' },
                  { fecha: '2026-02-20', nombre: 'Brucelosis', tipo: 'Obligatoria' },
                  { fecha: '2026-03-10', nombre: 'Carbunco', tipo: 'Recomendada' },
                ],
                genealogia: (producto.categoria === 'bovino' || producto.categoria === 'equino') ? {
                  padre: producto.raza ? `Toro ${producto.raza}` : 'Toro Angus',
                  padreRaza: producto.raza || 'Angus Negro',
                  madre: producto.raza ? `Vaca ${producto.raza}` : 'Vaca Angus',
                  madreRaza: producto.raza || 'Angus Negro',
                  abueloPaterno: 'Campeón Nacional',
                  abuelaPaterna: 'Vaca Premium',
                  abueloMaterno: 'Reproductor Élite',
                  abuelaMaterna: 'Vaca Lechera Record',
                } : undefined,
                id: producto.id,
              }} />
            </div>
          )}
          {producto.trazabilidad && (
            <div class="space-y-4">
              <QRTrazabilidad client:load productoId={producto.id} nombre={producto.nombre} />
            </div>
          )}
        </div>
      </div>
    </div>
  </div>
    ) : (
  <div id="fallback-container" data-slug="{slug}" class="max-w-4xl mx-auto px-4 py-16 text-center">
    <div id="fallback-loading" class="animate-pulse">
      <div class="w-16 h-16 bg-[#E8E0D8] rounded-full mx-auto mb-4"></div>
      <div class="h-4 bg-[#E8E0D8] rounded w-48 mx-auto mb-2"></div>
      <div class="h-3 bg-[#E8E0D8] rounded w-64 mx-auto"></div>
    </div>
    <div id="fallback-content" class="hidden text-left max-w-2xl mx-auto">
      <div class="flex items-center gap-2 text-sm text-[#6B6B6B] mb-6">
        <a href="/" class="hover:text-gold-700">Marketplace</a>
        <span>/</span>
        <a href="/marketplace" class="hover:text-gold-700">Productos</a>
        <span>/</span>
        <span id="fb-nombre" class="text-[#1A0E08] font-semibold"></span>
      </div>
      <div class="bg-white rounded-2xl shadow-sm border border-[#E8E0D8] p-6 space-y-4">
        <video id="fb-video" class="hidden w-full rounded-lg max-h-64 object-cover" controls playsinline></video>
        <div class="flex gap-4">
          <div class="w-32 h-32 bg-[#F5F0E8] rounded-xl flex items-center justify-center shrink-0" id="fb-img-container">
            <img id="fb-img" class="w-full h-full object-contain" src="/images/ganado.svg" alt="" />
          </div>
          <div class="flex-1">
            <h1 id="fb-nombre-lg" class="text-2xl font-bold text-[#1A0E08]"></h1>
            <p id="fb-categoria" class="text-sm text-[#6B6B6B] capitalize mt-1"></p>
            <p id="fb-precio" class="text-3xl font-extrabold text-gold-700 mt-3"></p>
            <div class="flex gap-2 mt-4">
              <a href="/marketplace" class="px-4 py-2 bg-[#F5F0E8] text-[#2D2D2D] rounded-lg text-sm font-semibold hover:bg-[#E8E0D8]">Volver al Marketplace</a>
              <button id="fb-contactar" class="px-4 py-2 bg-campo-600 text-white rounded-lg text-sm font-semibold hover:bg-campo-700">Contactar por WhatsApp</button>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div id="fallback-404" class="hidden">
      <svg class="w-16 h-16 text-[#C0B0A0] mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <h2 class="text-xl font-bold text-[#1A0E08] mb-2">Producto no encontrado</h2>
      <p class="text-[#6B6B6B] mb-6">Este producto no está disponible en el marketplace.</p>
      <a href="/marketplace" class="inline-flex items-center px-4 py-2 bg-campo-600 text-white rounded-lg font-semibold hover:bg-campo-700">Explorar Marketplace</a>
    </div>
  </div>
    )}
</BaseLayout>

<script>
  (function() {
    try {
      const fbContainer = document.getElementById('fallback-container');
      if (!fbContainer) return;
      const slug = fbContainer.getAttribute('data-slug');
      if (!slug) return;
      const localProductos = JSON.parse(localStorage.getItem('agrotech_productos') || '[]');
      const p = localProductos.find(item => String(item.id) === slug);
      if (p) {
        const fbLoading = document.getElementById('fallback-loading');
        const fbContent = document.getElementById('fallback-content');
        if (fbLoading) fbLoading.classList.add('hidden');
        if (fbContent) {
          fbContent.classList.remove('hidden');
      const img = p.imagenes?.[0] || '/images/ganado.svg';
      const setText = (id: string, txt: string) => { const el = document.getElementById(id); if (el) el.textContent = txt; };
      setText('fb-nombre', p.nombre || '');
      setText('fb-nombre-lg', p.nombre || '');
      setText('fb-categoria', p.categoria || '');
      setText('fb-precio', '$' + (parseInt(p.precio || 0).toLocaleString('es-CO')));
      if (p.video) {
        const videoEl = document.getElementById('fb-video');
        if (videoEl) {
          videoEl.src = p.video;
          videoEl.classList.remove('hidden');
        }
      }
          const imgEl = document.getElementById('fb-img');
          if (imgEl) imgEl.src = img;
          const contactar = document.getElementById('fb-contactar');
          if (contactar) contactar.onclick = () => window.open('https://wa.me/573001234567?text=' + encodeURIComponent('Hola, me interesa: ' + (p.nombre || '')), '_blank');
        }
        return;
      }
    } catch(e) {}
    const fbLoading = document.getElementById('fallback-loading');
    if (fbLoading) fbLoading.classList.add('hidden');
    const fb404 = document.getElementById('fallback-404');
    if (fb404) fb404.classList.remove('hidden');
  })();

  const productoIdEl = document.querySelector('[data-producto-id]');
  const curProductoId = productoIdEl ? parseInt(productoIdEl.dataset.productoId) : null;
  const curProductoNombre = productoIdEl ? productoIdEl.dataset.productoNombre : '';

  const ratingStars = document.querySelectorAll('.rating-star');
  const ratingText = document.getElementById('rating-text');
  const ratingSection = document.getElementById('rating-section');
  const ratingThanks = document.getElementById('rating-thanks');

  ratingStars.forEach((star) => {
    star.addEventListener('click', () => {
      const valor = parseInt(star.dataset.star);
      ratingStars.forEach((s, i) => {
        if (i < valor) {
          s.classList.remove('text-[#E8E0D8]');
          s.classList.add('text-gold-500');
        } else {
          s.classList.remove('text-gold-500');
          s.classList.add('text-[#E8E0D8]');
        }
      });
      ratingText.textContent = `Calificaste con ${valor} estrella${valor > 1 ? 's' : ''}`;
      setTimeout(() => {
        ratingSection.classList.add('hidden');
        ratingThanks.classList.remove('hidden');
        const calif = JSON.parse(localStorage.getItem('agrotech_calificaciones') || '[]');
        calif.push({ producto: curProductoId, rating: valor, fecha: new Date().toISOString() });
        localStorage.setItem('agrotech_calificaciones', JSON.stringify(calif));
      }, 800);
    });
  });

  const btnReportar = document.getElementById('btn-reportar');
  const reportarModal = document.getElementById('reportar-modal');
  const reportarForm = document.getElementById('reportar-form');
  const reportarGracias = document.getElementById('reportar-gracias');

  btnReportar?.addEventListener('click', () => {
    reportarModal.classList.remove('hidden');
  });

  reportarForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const motivo = document.getElementById('reportar-motivo').value;
    if (!motivo) return;
    reportarForm.classList.add('hidden');
    reportarGracias.classList.remove('hidden');
    const reportes = JSON.parse(localStorage.getItem('agrotech_reportes') || '[]');
    reportes.push({
      productoId: curProductoId,
      productoNombre: curProductoNombre,
      motivo,
      fecha: new Date().toISOString(),
    });
    localStorage.setItem('agrotech_reportes', JSON.stringify(reportes));
    setTimeout(() => {
      reportarModal.classList.add('hidden');
      reportarForm.classList.remove('hidden');
      reportarGracias.classList.add('hidden');
      document.getElementById('reportar-form').reset();
    }, 2000);
  });
</script>
