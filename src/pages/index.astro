---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import HeroMarketplace from '../components/marketplace/HeroMarketplace.astro';
import '../lib/db';
import { getProductosDestacados } from '../lib/models/productos.js';

const productosDest = await getProductosDestacados(6);
const productos = productosDest.filter(p => 
  ['bovino', 'equino', 'porcino', 'ovino', 'avicola'].includes(p.categoria)
);

const getReputacion = (vendedor: string) => {
  const hash = vendedor.split('').reduce((acc, char) => acc + char.charCodeAt(0), 0);
  const rating = 4.0 + (hash % 15) / 10;
  const ventas = 5 + (hash % 200);
  const badge = ventas > 100 ? 'top' : ventas > 20 ? 'verificado' : 'nuevo';
  return { rating: Math.round(rating * 10) / 10, ventas, badge };
};

const productosConReputacion = productos.map(p => {
  const rep = getReputacion(p.vendedor || 'Vendedor Demo');
  return {
    ...p,
    vendedorRating: rep.rating,
    vendedorVentas: rep.ventas,
    vendedorBadge: rep.badge,
  };
});
---

<BaseLayout hideNav>
  <HeroMarketplace />

  <!-- Productos Destacados -->
  <section class="reveal bg-[#FFFDF7] relative z-[31]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="flex items-center justify-between mb-10">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 bg-gradient-to-r from-campo-500 to-campo-600 rounded-xl flex items-center justify-center shadow-sm">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
          </svg>
        </div>
        <div>
          <h2 class="text-2xl md:text-3xl font-display font-bold text-[#2D2D2D]">Productos Destacados</h2>
          <p class="text-sm text-muted">Los mejores del campo colombiano</p>
        </div>
      </div>
      <a href="/marketplace" class="inline-flex items-center gap-2 text-sm font-semibold text-campo-600 hover:text-campo-700 transition-colors">
        Ver todos
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-6 md:gap-8">
      {productosConReputacion.map((producto) => (
        <ProductCard producto={producto} />
      ))}
    </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="reveal bg-[#FFFDF7] relative z-[31]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="rounded-2xl p-10 md:p-14 text-center text-white relative overflow-hidden bg-cover bg-center" style="background-image: url('/images/paginaprincipal_agroup.webp');">
      <div class="absolute inset-0 bg-black/50"></div>
      <div class="relative">
        <div class="w-16 h-16 bg-white/10 rounded-xl flex items-center justify-center mx-auto mb-6">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
          </svg>
        </div>
        <h2 class="text-2xl md:text-3xl font-display font-bold mb-4">¿Quieres vender tu ganado?</h2>
        <p class="text-white/80 text-lg max-w-2xl mx-auto mb-8">
          Publica tu ganado en nuestro marketplace y conecta directamente con compradores de todo el país.
          Sin intermediarios, mejores precios.
        </p>
        <a
          href="/publicar"
          class="inline-flex items-center gap-2 px-8 py-4 bg-campo-850 text-white font-bold rounded-xl hover:bg-campo-900 shadow-lg hover:shadow-xl transition-all duration-200 active:scale-[0.98]"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
          </svg>
          Publicar Ahora
        </a>
      </div>
    </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="reveal bg-white border-y border-[#E8E0D8] relative z-[31]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="text-center mb-12">
        <h2 class="text-2xl md:text-3xl font-display font-bold text-[#2D2D2D] mb-3">¿Por qué elegir Agroup?</h2>
        <p class="text-muted">La mejor plataforma para comprar y vender ganado</p>
      </div>
      <div class="grid grid-cols-2 gap-8 max-w-2xl mx-auto">
        <div class="bg-[#FFFDF7] rounded-2xl p-8 text-center shadow-sm border border-coffee-100 hover:shadow-lg transition-shadow">
          <div class="w-16 h-16 mx-auto bg-campo-100 rounded-2xl flex items-center justify-center mb-5">
            <svg class="w-8 h-8 text-campo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 00-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h4 class="font-bold text-lg text-[#2D2D2D] mb-2">Compra Segura</h4>
          <p class="text-sm text-muted">Trazabilidad verificada en cada producto</p>
        </div>
        <div class="bg-[#FFFDF7] rounded-2xl p-8 text-center shadow-sm border border-coffee-100 hover:shadow-lg transition-shadow">
          <div class="w-16 h-16 mx-auto bg-orange-100 rounded-2xl flex items-center justify-center mb-5">
            <svg class="w-8 h-8 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <h4 class="font-bold text-lg text-[#2D2D2D] mb-2">Sin Intermediarios</h4>
          <p class="text-sm text-muted">Contacta directo al vendedor</p>
        </div>
        <div class="bg-[#FFFDF7] rounded-2xl p-8 text-center shadow-sm border border-coffee-100 hover:shadow-lg transition-shadow">
          <div class="w-16 h-16 mx-auto bg-campo-100 rounded-2xl flex items-center justify-center mb-5">
            <svg class="w-8 h-8 text-campo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <h4 class="font-bold text-lg text-[#2D2D2D] mb-2">Manizales</h4>
          <p class="text-sm text-muted">El corazón ganadero de Colombia</p>
        </div>
        <div class="bg-[#FFFDF7] rounded-2xl p-8 text-center shadow-sm border border-coffee-100 hover:shadow-lg transition-shadow">
          <div class="w-16 h-16 mx-auto bg-orange-100 rounded-2xl flex items-center justify-center mb-5">
            <svg class="w-8 h-8 text-orange-700" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
          </div>
          <h4 class="font-bold text-lg text-[#2D2D2D] mb-2">WhatsApp</h4>
          <p class="text-sm text-muted">Negocia directo por chat</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .reveal {
    opacity: 0;
    transform: translateY(40px) scale(0.96);
    transition: opacity 800ms cubic-bezier(0.16, 1, 0.3, 1),
                transform 800ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.25 });

    document.querySelectorAll('.reveal').forEach(function (el) {
      observer.observe(el);
    });
  });
</script>
