---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import HeroMarketplace from '../components/marketplace/HeroMarketplace.astro';
import '../lib/db';
import { getProductosRecientes } from '../lib/models/productos.js';

const productos = await getProductosRecientes(4);

const getReputacion = (vendedor: string) => {
  const hash = vendedor.split('').reduce((acc, char) => acc + char.charCodeAt(0), 0);
  const rating = 4.0 + (hash % 15) / 10;
  const ventas = 5 + (hash % 200);
  const badge = ventas > 100 ? 'top' : ventas > 20 ? 'verificado' : 'nuevo';
  return { rating: Math.round(rating * 10) / 10, ventas, badge };
};

const productosConReputacion = productos.map(p => {
  const rep = getReputacion(p.vendedor || 'Vendedor Demo');
  return {
    ...p,
    vendedorRating: rep.rating,
    vendedorVentas: rep.ventas,
    vendedorBadge: rep.badge,
  };
});
---

<BaseLayout hideNav>
  <HeroMarketplace />

  <!-- Productos Destacados -->
  <section class="reveal bg-[#FFFDF7] relative z-[31]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="flex items-center justify-between mb-10">
