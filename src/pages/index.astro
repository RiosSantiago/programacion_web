                transform 800ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .reveal.is-visible {
    opacity: 1;
    transform: none;
  }
  .scroll-cards-wrapper {
    position: relative;
    height: 320vh;
  }

  .scroll-cards-sticky {
    position: sticky;
    top: 12vh;
    padding: 4vh 0;
  }

  .feature-card {
    opacity: 0.4;
    transform: scale(0.94);
    filter: grayscale(40%);
  }

  .feature-card.is-active {
    opacity: 1;
    transform: scale(1);
    filter: grayscale(0%);
    box-shadow: 0 20px 40px -20px rgba(0,0,0,0.25);
  }
  

  @media (prefers-reduced-motion: reduce) {
    .feature-card { transition: none; }
  }

  @media (max-width: 640px) {
    .scroll-cards-wrapper { height: 260vh; }
  }

  .card-slot {
    position: relative;
  }

  .card-reveal-image {
    position: absolute;
    top: 8%;
    bottom: 8%;
    width: 65%;
    border-radius: 1.25rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 1rem;
    z-index: 0;
    opacity: 0;
    box-shadow: 0 20px 40px -15px rgba(0,0,0,0.35);
    transition: transform 0.55s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s ease;
    pointer-events: none;
  }

  .card-slot[data-side="left"] .card-reveal-image {
    left: 0;
    transform: translateX(0%);
  }
  .card-slot[data-side="right"] .card-reveal-image {
    right: 0;
    transform: translateX(0%);
  }

  .card-slot .feature-card {
    position: relative;
    z-index: 1;
  }

  .card-slot.is-active .card-reveal-image {
    opacity: 1;
  }
  .card-slot[data-side="left"].is-active .card-reveal-image {
    transform: translateX(-80%);
  }
  .card-slot[data-side="right"].is-active .card-reveal-image {
    transform: translateX(80%);
  }

  @media (max-width: 640px) {
    .card-reveal-image { display: none; }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.25 });

    document.querySelectorAll('.reveal').forEach(function (el) {
      observer.observe(el);
    });
  });
</script>
<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    const wrapper = document.querySelector('.scroll-cards-wrapper');
    const cards = document.querySelectorAll('.feature-card');
    if (!wrapper || !cards.length) return;

    function onScroll() {
      const rect = wrapper.getBoundingClientRect();
      const scrollable = wrapper.offsetHeight - window.innerHeight;
      const scrolled = -rect.top;
      const progress = Math.min(Math.max(scrolled / scrollable, 0), 1);
      const activeIndex = Math.min(cards.length - 1, Math.floor(progress * cards.length));

      cards.forEach((card, i) => {
        const active = i === activeIndex;
        card.classList.toggle('is-active', active);
        card.closest('.card-slot')?.classList.toggle('is-active', active);
      });
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  });
</script>
