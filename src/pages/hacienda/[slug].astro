---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { queryGet } from '../../lib/db';
import { getProductos } from '../../lib/models/productos.js';

const { slug } = Astro.params;
const slugNombre = (slug || '').replace(/-/g, ' ');

const allProductos = await getProductos();
const haciendaProductos = allProductos.filter((p: any) => {
  const v = (p.vendedor || '').toLowerCase().replace(/\s+/g, '-');
  return v === slug || slugNombre.includes((p.vendedor || '').toLowerCase());
});

const vendedorNombre = haciendaProductos.length > 0
  ? haciendaProductos[0].vendedor
  : slug ? slug.replace(/-/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase()) : 'Hacienda';

const vendedorId = haciendaProductos.length > 0 ? haciendaProductos[0].vendedor_id : null;
let vendedorUser: any = null;
if (vendedorId) {
  vendedorUser = await queryGet('SELECT logo, portada, descripcion, whatsapp, departamento, created_at FROM usuarios WHERE id = ?', [vendedorId]);
}

let ventasReales = 0;
if (vendedorId) {
  const ventasRow = await queryGet<{ count: string }>(
    `SELECT COUNT(DISTINCT d.pedido_id) as count FROM detalle_pedido d JOIN productos p ON d.producto_id = p.id WHERE p.vendedor_id = ?`,
    [vendedorId]
  );
  ventasReales = Number(ventasRow?.count ?? 0);
  if (ventasReales === 0) {
    const legacyRow = await queryGet<{ count: string }>("SELECT COUNT(*) as count FROM pedidos WHERE productos LIKE ?", [`%"vendedor_id":${vendedorId}%`]);
    ventasReales = Number(legacyRow?.count ?? 0);
  }
}

const ratingRow = vendedorId
  ? await queryGet<any>("SELECT AVG(vendedor_rating) as avg_rating FROM productos WHERE vendedor_id = ? AND vendedor_rating IS NOT NULL AND vendedor_rating > 0", [vendedorId])
  : null;
const ratingReal = ratingRow?.avg_rating ? parseFloat(ratingRow.avg_rating) : null;

const meses = ['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];
let miembroDesde = '2026';
if (vendedorUser?.created_at) {
  const d = new Date(vendedorUser.created_at);
  miembroDesde = `${meses[d.getMonth()]} ${d.getFullYear()}`;
}

const hacienda = {
  nombre: vendedorNombre,
  slug: slug || 'hacienda',
  logo: vendedorUser?.logo || '',
  portada: vendedorUser?.portada || '',
  descripcion: vendedorUser?.descripcion || 'Hacienda familiar dedicada a la cría y engorde de ganado bovino con trazabilidad completa.',
  ubicacion: `${haciendaProductos[0]?.departamento || 'Manizales'}, ${haciendaProductos[0]?.departamento || 'Caldas'}`,
  departamento: vendedorUser?.departamento || haciendaProductos[0]?.departamento || 'Caldas',
  municipio: haciendaProductos[0]?.ubicacion || 'Manizales',
  whatsapp: vendedorUser?.whatsapp || '3001234567',
  especies: (haciendaProductos.length > 0 ? [...new Set(haciendaProductos.map((p: any) => p.categoria).filter(Boolean))] : ['Bovinos', 'Porcinos']) as string[],
  rating: ratingReal ? Math.round(ratingReal * 10) / 10 : 0,
  ventas: ventasReales,
  miembroDesde,
  urlPublica: `/hacienda/${slug || 'hacienda'}`,
  publicacionesActivas: haciendaProductos.length,
};

const ventasHacienda: any[] = [];

const categorias = [...new Set(haciendaProductos.map((p: any) => p.categoria).filter(Boolean))];
---

<BaseLayout navVariant="market">
  <div class="bg-[#FFFDF7] min-h-screen">

    <section class="relative overflow-hidden">
      {hacienda.portada ? (
        <div class="relative h-64 sm:h-80 lg:h-96">
          <img src={hacienda.portada} alt="" class="w-full h-full object-cover" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
          <div class="absolute inset-0 bg-gradient-to-r from-campo-900/40 to-transparent"></div>
          <div class="absolute inset-0 opacity-[0.03]" style="background-image: url('data:image/svg+xml,%3Csvg width=&quot;60&quot; height=&quot;60&quot; viewBox=&quot;0 0 60 60&quot; xmlns=&quot;http://www.w3.org/2000/svg&quot;%3E%3Cg fill=&quot;none&quot; fill-rule=&quot;evenodd&quot;%3E%3Cg fill=&quot;%23ffffff&quot; fill-opacity=&quot;1&quot;%3E%3Cpath d=&quot;M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z&quot;/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"></div>
        </div>
      ) : (
        <div class="relative h-64 sm:h-80 lg:h-96 bg-gradient-to-br from-campo-800 via-campo-700 to-campo-900">
          <div class="absolute inset-0 opacity-[0.04]" style="background-image: url('data:image/svg+xml,%3Csvg width=&quot;40&quot; height=&quot;40&quot; viewBox=&quot;0 0 40 40&quot; xmlns=&quot;http://www.w3.org/2000/svg&quot;%3E%3Cg fill=&quot;%23ffffff&quot; fill-opacity=&quot;1&quot; fill-rule=&quot;evenodd&quot;%3E%3Cpath d=&quot;M0 40L40 0H20L0 20M40 40V20L20 40&quot;/%3E%3C/g%3E%3C/svg%3E');"></div>
          <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-campo-900/60"></div>
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="text-center text-white/20">
              <svg class="w-24 h-24 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
              </svg>
            </div>
          </div>
        </div>
      )}

      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 -mt-16 relative z-10">
        <div class="bg-white rounded-2xl border border-[#1b3928] shadow-lg p-5 sm:p-8">
          <div class="flex flex-col sm:flex-row gap-5 sm:gap-8">
            <div class="shrink-0 self-center sm:self-start">
              {hacienda.logo ? (
                <img src={hacienda.logo} alt={hacienda.nombre} class="w-20 h-20 sm:w-28 sm:h-28 rounded-2xl border-4 border-white shadow-lg object-cover bg-white" />
              ) : (
                <div class="w-20 h-20 sm:w-28 sm:h-28 rounded-2xl border-4 border-white shadow-lg bg-gradient-to-br from-campo-500 to-campo-700 flex items-center justify-center">
                  <span class="text-2xl sm:text-4xl font-display font-bold text-white">{hacienda.nombre[0]}</span>
                </div>
              )}
            </div>

            <div class="flex-1 text-center sm:text-left">
              <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
                <div>
                  <div class="flex items-center justify-center sm:justify-start gap-2 flex-wrap">
                    <h1 class="text-2xl sm:text-3xl font-display font-bold text-[#1A0E08]">{hacienda.nombre}</h1>
                    {hacienda.rating >= 4.5 && (
                      <span class="inline-flex items-center gap-1 px-2 py-0.5 bg-gold-100 text-gold-800 text-xs font-semibold rounded-full">
                        <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                        Top Seller
                      </span>
                    )}
                  </div>
                  <div class="flex flex-wrap items-center justify-center sm:justify-start gap-3 mt-2 text-sm text-[#6B6B6B]">
                    <span class="flex items-center gap-1.5">
                      <svg class="w-4 h-4 text-campo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                      {hacienda.municipio}, {hacienda.departamento}
                    </span>
                    <span class="w-px h-3 bg-[#E8E0D8]"></span>
                    <span class="flex items-center gap-1.5">
                      <svg class="w-4 h-4 text-campo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                      Miembro desde {hacienda.miembroDesde}
                    </span>
                  </div>
                </div>

                <a
                  href={`https://wa.me/57${hacienda.whatsapp.replace(/\D/g, '')}`}
                  target="_blank"
                  class="inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-gradient-to-r from-green-500 to-green-600 text-white text-sm font-bold rounded-xl hover:from-green-600 hover:to-green-700 transition-all shadow-md hover:shadow-lg shrink-0"
                >
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                  Contactar por WhatsApp
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">

      <nav class="flex items-center gap-2 text-sm text-[#6B6B6B]">
        <a href="/" class="hover:text-campo-700 transition-colors font-medium">Marketplace</a>
        <svg class="w-4 h-4 text-[#C0B0A0]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        <span class="text-campo-700 font-semibold">{hacienda.nombre}</span>
      </nav>

      <section class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
        <div class="bg-white rounded-2xl border border-[#E8E0D8] shadow-sm p-4 sm:p-5 text-center hover:shadow-md transition-shadow group">
          <div class="w-10 h-10 sm:w-12 sm:h-12 mx-auto mb-3 bg-campo-100 rounded-xl flex items-center justify-center group-hover:bg-campo-200 transition-colors">
            <svg class="w-5 h-5 sm:w-6 sm:h-6 text-campo-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
          </div>
          <p class="text-2xl sm:text-3xl font-display font-bold text-[#1A0E08]">{hacienda.publicacionesActivas}</p>
          <p class="text-xs sm:text-sm text-[#6B6B6B] mt-1">Publicaciones</p>
        </div>
        <div class="bg-white rounded-2xl border border-[#E8E0D8] shadow-sm p-4 sm:p-5 text-center hover:shadow-md transition-shadow group">
          <div class="w-10 h-10 sm:w-12 sm:h-12 mx-auto mb-3 bg-gold-100 rounded-xl flex items-center justify-center group-hover:bg-gold-200 transition-colors">
            <svg class="w-5 h-5 sm:w-6 sm:h-6 text-gold-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          </div>
          <p class="text-2xl sm:text-3xl font-display font-bold text-[#1A0E08]">{hacienda.ventas}</p>
          <p class="text-xs sm:text-sm text-[#6B6B6B] mt-1">Ventas verificadas</p>
        </div>
        <div class="bg-white rounded-2xl border border-[#E8E0D8] shadow-sm p-4 sm:p-5 text-center hover:shadow-md transition-shadow group">
          <div class="w-10 h-10 sm:w-12 sm:h-12 mx-auto mb-3 bg-gold-100 rounded-xl flex items-center justify-center group-hover:bg-gold-200 transition-colors">
            <svg class="w-5 h-5 sm:w-6 sm:h-6 text-gold-600" fill="currentColor" viewBox="0 0 24 24"><path d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" /></svg>
          </div>
          <p class="text-2xl sm:text-3xl font-display font-bold text-[#1A0E08]">{hacienda.rating > 0 ? hacienda.rating : 'N/A'}</p>
          <p class="text-xs sm:text-sm text-[#6B6B6B] mt-1">Calificación</p>
        </div>
        <div class="bg-white rounded-2xl border border-[#E8E0D8] shadow-sm p-4 sm:p-5 text-center hover:shadow-md transition-shadow group">
          <div class="w-10 h-10 sm:w-12 sm:h-12 mx-auto mb-3 bg-cielo-100 rounded-xl flex items-center justify-center group-hover:bg-cielo-200 transition-colors">
            <svg class="w-5 h-5 sm:w-6 sm:h-6 text-cielo-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" /></svg>
          </div>
          <p class="text-2xl sm:text-3xl font-display font-bold text-[#1A0E08]">{hacienda.especies.length}</p>
          <p class="text-xs sm:text-sm text-[#6B6B6B] mt-1">Especies</p>
        </div>
      </section>

      <div class="flex flex-wrap gap-2">
        {hacienda.especies.map((specie: string) => (
          <span class="filtro-chip px-4 py-2 bg-campo-50 text-campo-800 text-sm font-semibold rounded-xl border border-campo-200">{specie}</span>
        ))}
      </div>

      {hacienda.descripcion && (
        <section class="bg-white rounded-2xl border border-[#E8E0D8] shadow-sm overflow-hidden">
          <div class="p-6 sm:p-8">
            <div class="flex items-center gap-3 mb-5">
              <div class="w-10 h-10 bg-campo-100 rounded-xl flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-campo-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              </div>
              <h2 class="text-lg font-display font-bold text-[#1A0E08]">Acerca de {hacienda.nombre}</h2>
            </div>
            <p class="text-sm sm:text-base text-[#6B6B6B] leading-relaxed">{hacienda.descripcion}</p>

            <div class="mt-6 pt-6 border-t border-[#E8E0D8]">
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div class="flex items-center gap-3 p-3 bg-[#FFFDF7] rounded-xl border border-[#E8E0D8]">
                  <div class="w-9 h-9 bg-campo-100 rounded-lg flex items-center justify-center shrink-0">
                    <svg class="w-4 h-4 text-campo-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                  </div>
                  <div>
                    <p class="text-xs text-[#6B6B6B]">Ubicación</p>
                    <p class="text-sm font-semibold text-[#1A0E08]">{hacienda.municipio}, {hacienda.departamento}</p>
                  </div>
                </div>
                <div class="flex items-center gap-3 p-3 bg-[#FFFDF7] rounded-xl border border-[#E8E0D8]">
                  <div class="w-9 h-9 bg-gold-100 rounded-lg flex items-center justify-center shrink-0">
                    <svg class="w-4 h-4 text-gold-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                  </div>
                  <div>
                    <p class="text-xs text-[#6B6B6B]">Miembro desde</p>
                    <p class="text-sm font-semibold text-[#1A0E08] capitalize">{hacienda.miembroDesde}</p>
                  </div>
                </div>
                <div class="flex items-center gap-3 p-3 bg-[#FFFDF7] rounded-xl border border-[#E8E0D8]">
                  <div class="w-9 h-9 bg-cielo-100 rounded-lg flex items-center justify-center shrink-0">
                    <svg class="w-4 h-4 text-cielo-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
                  </div>
                  <div>
                    <p class="text-xs text-[#6B6B6B]">Verificación</p>
                    <p class="text-sm font-semibold text-[#1A0E08]">Vendedor verificado</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>
      )}

      {ventasHacienda.length > 0 && (
        <section class="bg-white rounded-2xl border border-[#E8E0D8] shadow-sm p-6 sm:p-8">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 bg-gold-100 rounded-xl flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-gold-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>
            </div>
            <h2 class="text-lg font-display font-bold text-[#1A0E08]">Lo que dicen nuestros compradores</h2>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {ventasHacienda.map((venta: any) => (
              <div class="relative bg-[#FFFDF7] rounded-xl border border-[#E8E0D8] p-5 hover:shadow-sm transition-shadow">
                <div class="absolute top-4 right-4 text-campo-200">
                  <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24"><path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/></svg>
                </div>
                <div class="flex items-center gap-3 mb-3">
                  <div class="w-10 h-10 bg-gradient-to-br from-campo-500 to-campo-700 rounded-full flex items-center justify-center shrink-0">
                    <span class="text-sm font-bold text-white">{venta.comprador?.[0] || 'C'}</span>
                  </div>
                  <div>
                    <p class="text-sm font-semibold text-[#1A0E08]">{venta.comprador || 'Anónimo'}</p>
                    <p class="text-xs text-[#6B6B6B]">{venta.fecha || ''}</p>
                  </div>
                </div>
                <p class="text-sm text-[#2D2D2D] mb-3">Compró: <span class="font-medium">{venta.producto}</span></p>
                <div class="flex items-center gap-0.5">
                  {[1, 2, 3, 4, 5].map((star) => (
                     <svg class={`w-4 h-4 ${star <= venta.calificacion ? 'text-gold-500' : 'text-[#E8E0D8]'}`} fill="currentColor" viewBox="0 0 24 24">
                      <path d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
                    </svg>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      <section>
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-5">
          <div>
            <h2 class="text-xl font-display font-bold text-[#1A0E08]">Publicaciones Activas</h2>
            <p class="text-sm text-[#6B6B6B] mt-1">{hacienda.publicacionesActivas} productos disponibles en el marketplace</p>
          </div>
          <div class="flex items-center gap-2" id="filtro-categorias">
            <button class="filtro-chip px-3 py-1.5 text-xs font-semibold rounded-lg border border-campo-300 bg-campo-600 text-white data-[active=false]:bg-white data-[active=false]:text-[#6B6B6B] data-[active=false]:border-[#E8E0D8]" data-categoria="todos" data-active="true">
              Todos
            </button>
            {categorias.map((cat: string) => (
              <button class="filtro-chip px-3 py-1.5 text-xs font-semibold rounded-lg border border-campo-300 bg-campo-600 text-white data-[active=false]:bg-white data-[active=false]:text-[#6B6B6B] data-[active=false]:border-[#E8E0D8]" data-categoria={cat} data-active="false">
                {cat}
              </button>
            ))}
            <span class="w-px h-5 bg-[#E8E0D8] mx-1 hidden sm:block"></span>
            <button id="toggle-view-btn" class="p-2 rounded-lg border border-[#E8E0D8] bg-white text-[#6B6B6B] hover:text-[#1A0E08] hover:border-[#C0B0A0] transition-colors" title="Cambiar vista">
              <svg id="icon-grid" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" /></svg>
              <svg id="icon-list" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16" /></svg>
            </button>
          </div>
        </div>

        {haciendaProductos.length > 0 ? (
          <div id="hacienda-grid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 md:gap-4">
            {haciendaProductos.map((producto: any) => (
              <div class="hacienda-producto" data-categoria={producto.categoria}>
                <ProductCard producto={producto} />
              </div>
            ))}
          </div>
        ) : (
          <div class="text-center py-16 bg-white rounded-2xl border border-[#E8E0D8]">
            <div class="w-16 h-16 bg-[#F5F0E8] rounded-2xl flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-[#C0B0A0]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" /></svg>
            </div>
            <p class="text-[#6B6B6B] font-medium">Esta hacienda no tiene publicaciones activas</p>
            <p class="text-sm text-[#C0B0A0] mt-1">Vuelve pronto para ver nuevos productos</p>
          </div>
        )}
      </section>
    </div>

    <a
      href={`https://wa.me/57${hacienda.whatsapp.replace(/\D/g, '')}`}
      target="_blank"
      id="fab-whatsapp"
      class="fixed bottom-6 right-6 z-40 w-14 h-14 bg-gradient-to-br from-green-500 to-green-600 text-white rounded-full shadow-lg hover:shadow-xl hover:from-green-600 hover:to-green-700 transition-all flex items-center justify-center sm:hidden"
    >
      <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
    </a>
  </div>
</BaseLayout>

<script>
  const filtroContainer = document.getElementById('filtro-categorias');
  if (filtroContainer) {
    const botones = filtroContainer.querySelectorAll('button[data-categoria]');
    botones.forEach(btn => {
      btn.addEventListener('click', () => {
        botones.forEach(b => b.setAttribute('data-active', 'false'));
        btn.setAttribute('data-active', 'true');
        const cat = btn.getAttribute('data-categoria');
        const cards = document.querySelectorAll('.hacienda-producto');
        cards.forEach(card => {
          const cardCat = card.getAttribute('data-categoria');
          (card as HTMLElement).style.display = (cat === 'todos' || cardCat === cat) ? '' : 'none';
        });
      });
    });
  }

  const toggleBtn = document.getElementById('toggle-view-btn');
  const grid = document.getElementById('hacienda-grid');
  const iconGrid = document.getElementById('icon-grid');
  const iconList = document.getElementById('icon-list');
  if (toggleBtn && grid) {
    toggleBtn.addEventListener('click', () => {
      const isGrid = grid.classList.contains('grid-cols-2');
      if (isGrid) {
        grid.className = 'grid grid-cols-1 gap-3';
        iconGrid?.classList.add('hidden');
        iconList?.classList.remove('hidden');
      } else {
        grid.className = 'grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 md:gap-4';
        iconGrid?.classList.remove('hidden');
        iconList?.classList.add('hidden');
      }
    });
  }
</script>
