---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Mis Pedidos - AgroUp" navVariant="market">
  <div class="min-h-screen bg-stone-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-4">
      <nav class="flex items-center gap-2 text-sm" style="color: #9CA3AF">
        <a href="/" class="hover:opacity-80 transition-opacity font-medium">Marketplace</a>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        <a href="/dashboard" class="hover:opacity-80 transition-opacity font-medium">Mi Hacienda</a>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        <span style="color: #1b3928; font-weight: 600;">Mis Pedidos</span>
      </nav>
    </div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h1 class="text-3xl font-bold" style="font-family: 'Cormorant Garamond', Georgia, serif; color: #1A0E08;">Mis Pedidos</h1>
          <p class="text-sm mt-1" style="color: #6B7280;">Historial de tus compras en el marketplace</p>
        </div>
        <a href="/marketplace" class="inline-flex items-center gap-2 px-4 py-2.5 text-sm font-semibold text-white rounded-xl transition-colors" style="background-color: #1b3928;" onmouseover="this.style.backgroundColor='#0A5C43'" onmouseout="this.style.backgroundColor='#1b3928'">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" /></svg>
          Explorar Marketplace
        </a>
      </div>

      <div id="pedidos-loading" class="space-y-4">
        {[1, 2, 3].map(() => (
          <div class="bg-white rounded-2xl border border-[#E8E0D8] p-6 animate-pulse">
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 rounded-xl bg-slate-100"></div>
              <div class="flex-1 space-y-2">
                <div class="h-4 bg-slate-100 rounded w-1/3"></div>
                <div class="h-3 bg-slate-100 rounded w-1/4"></div>
              </div>
              <div class="h-6 w-20 bg-slate-100 rounded-full"></div>
            </div>
          </div>
        ))}
      </div>

      <div id="pedidos-empty" class="hidden text-center py-16">
        <div class="w-20 h-20 rounded-2xl mx-auto mb-6 flex items-center justify-center" style="background-color: #F0F7F0;">
          <svg class="w-10 h-10" style="color: #A5D6A7;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
        </div>
        <h3 class="text-xl font-bold" style="font-family: 'Cormorant Garamond', Georgia, serif; color: #1A0E08;">Aún no tienes pedidos</h3>
        <p class="text-sm mt-2" style="color: #6B7280;">Explora el marketplace y encuentra el mejor ganado para tu hacienda.</p>
        <a href="/marketplace" class="inline-flex items-center gap-2 mt-6 px-6 py-3 text-sm font-semibold text-white rounded-xl transition-colors" style="background-color: #1b3928;">
          Ir al Marketplace
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
        </a>
      </div>

      <div id="pedidos-list" class="space-y-4"></div>
    </div>
  </div>

  <script>
    const ESTADO_COLORS: Record<string, string> = {
      pendiente: 'background:#FEF3C7; color:#92400E;',
      pagado: 'background:#D1FAE5; color:#065F46;',
      enviado: 'background:#DBEAFE; color:#1E40AF;',
      entregado: 'background:#D1FAE5; color:#065F46;',
      completado: 'background:#D1FAE5; color:#065F46;',
      cancelado: 'background:#FEE2E2; color:#991B1B;',
      rechazado: 'background:#FEE2E2; color:#991B1B;',
      error: 'background:#FEE2E2; color:#991B1B;',
      anulado: 'background:#FEE2E2; color:#991B1B;',
      expirado: 'background:#F3F4F6; color:#374151;',
    };

    const ESTADO_LABELS: Record<string, string> = {
      pendiente: 'Pendiente',
      pagado: 'Pagado',
      enviado: 'Enviado',
      entregado: 'Entregado',
      completado: 'Completado',
      cancelado: 'Cancelado',
      rechazado: 'Rechazado',
      error: 'Error',
      anulado: 'Anulado',
      expirado: 'Expirado',
    };

    const METODO_LABELS: Record<string, string> = {
      pse: 'PSE',
      tarjeta: 'Tarjeta',
      nequi: 'Nequi',
      daviplata: 'Daviplata',
      efectivo: 'Efectivo',
      whatsapp: 'WhatsApp',
    };

    function formatCOP(value: number): string {
      return new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', minimumFractionDigits: 0 }).format(value);
    }

    function formatDate(dateStr: string): string {
      const d = new Date(dateStr);
      const day = d.getDate().toString().padStart(2, '0');
      const months = ['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'];
      return `${day} ${months[d.getMonth()]} ${d.getFullYear()}`;
    }

    function renderPedido(pedido: any): string {
      const estado = pedido.estado || 'pendiente';
      const estadoStyle = ESTADO_COLORS[estado] || ESTADO_COLORS.pendiente;
      const estadoLabel = ESTADO_LABELS[estado] || estado;
      const metodoLabel = METODO_LABELS[pedido.metodo_pago] || pedido.metodo_pago || 'N/A';
      const productos = pedido.productos || [];

      return `
        <div class="bg-white rounded-2xl border border-[#E8E0D8] shadow-sm overflow-hidden transition-all hover:shadow-md" style="cursor:pointer;" onclick="this.querySelector('.pedido-detalle')?.classList.toggle('hidden')">
          <div class="p-5 sm:p-6">
            <div class="flex flex-col sm:flex-row sm:items-center gap-4">
              <div class="flex items-center gap-3 flex-1 min-w-0">
                <div class="w-11 h-11 rounded-xl flex items-center justify-center flex-shrink-0" style="background-color: #F0F7F0;">
                  <svg class="w-5 h-5" style="color: #1b3928;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                  </svg>
                </div>
                <div class="min-w-0">
                  <p class="text-sm font-bold truncate" style="color: #1A0E08;">${pedido.orden_id}</p>
                  <p class="text-xs" style="color: #9CA3AF;">${formatDate(pedido.created_at)} · ${metodoLabel}</p>
                </div>
              </div>
              <div class="flex items-center gap-3">
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold whitespace-nowrap" style="${estadoStyle}">${estadoLabel}</span>
                <p class="text-lg font-bold tabular-nums" style="color: #1A0E08;">${formatCOP(pedido.total)}</p>
              </div>
            </div>
          </div>

          <div class="pedido-detalle hidden border-t border-[#E8E0D8] bg-stone-50 p-5 sm:p-6 space-y-4">
            ${productos.length > 0 ? `
              <div class="space-y-3">
                <p class="text-xs font-semibold uppercase tracking-wider" style="color: #9CA3AF;">Productos</p>
                ${productos.map((prod: any) => `
                  <div class="flex items-center gap-3 bg-white rounded-xl p-3 border border-[#E8E0D8]">
                    <img src="${prod.imagen || '/images/ganado.svg'}" alt="${prod.nombre}" class="w-12 h-12 object-cover rounded-lg" onerror="this.src='/images/ganado.svg'" />
                    <div class="flex-1 min-w-0">
                      <p class="text-sm font-semibold truncate" style="color: #1A0E08;">${prod.nombre}</p>
                      <p class="text-xs" style="color: #9CA3AF;">Cant: ${prod.cantidad} × ${formatCOP(prod.precio_unitario)}</p>
                    </div>
                    <p class="text-sm font-bold flex-shrink-0" style="color: #1b3928;">${formatCOP(prod.cantidad * prod.precio_unitario)}</p>
                  </div>
                `).join('')}
              </div>
            ` : '<p class="text-sm" style="color: #9CA3AF;">Detalle de productos no disponible.</p>'}

            ${pedido.direccion ? `
              <div class="bg-white rounded-xl p-3 border border-[#E8E0D8]">
                <p class="text-xs font-semibold uppercase tracking-wider mb-1" style="color: #9CA3AF;">Dirección de entrega</p>
                <p class="text-sm" style="color: #1A0E08;">${pedido.direccion}</p>
              </div>
            ` : ''}

            ${pedido.notas ? `
              <div class="bg-white rounded-xl p-3 border border-[#E8E0D8]">
                <p class="text-xs font-semibold uppercase tracking-wider mb-1" style="color: #9CA3AF;">Notas</p>
                <p class="text-sm" style="color: #1A0E08;">${pedido.notas}</p>
              </div>
            ` : ''}
          </div>
        </div>
      `;
    }

    async function loadPedidos() {
      const loading = document.getElementById('pedidos-loading');
      const empty = document.getElementById('pedidos-empty');
      const list = document.getElementById('pedidos-list');

      try {
        const token = localStorage.getItem('agroup_token');
        if (!token) {
          window.location.href = '/auth/login?redirect=/hacienda/pedidos';
          return;
        }

        const res = await fetch('/api/pedidos/mis-pedidos', {
          headers: { Authorization: `Bearer ${token}` },
        });

        if (!res.ok) throw new Error('Error al cargar pedidos');

        const pedidos = await res.json();

        if (loading) loading.classList.add('hidden');

        if (!pedidos || pedidos.length === 0) {
          if (empty) empty.classList.remove('hidden');
          return;
        }

        if (list) {
          list.innerHTML = pedidos.map(renderPedido).join('');
        }
      } catch (err) {
        console.error('Error:', err);
        if (loading) loading.classList.add('hidden');
        if (empty) {
          empty.classList.remove('hidden');
          const h3 = empty.querySelector('h3');
          if (h3) h3.textContent = 'Error al cargar pedidos';
        }
      }
    }

    loadPedidos();
  </script>
</BaseLayout>
