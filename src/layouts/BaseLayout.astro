---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import FavoritesDrawer from '../components/FavoritesDrawer.astro';
import '../styles/global.css';

export interface Props {
  hideNav?: boolean;
  navVariant?: 'dark' | 'light' | 'home' | 'market' | 'publicar';
}

const { hideNav, navVariant } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Agroup - El marketplace ganadero de los Andes colombianos. Compra y vende bovinos, equinos, porcinos y más directamente de los mejores productores de Manizales y Caldas." />
    <meta name="keywords" content="ganado, bovinos, caballos, marketplace, manizales, caldas, colombia, ganado colombiano, compra ganado, vende ganado" />
    <meta name="author" content="Agroup" />
    <meta property="og:title" content="Agroup | Marketplace Ganadero - Manizales, Colombia" />
    <meta property="og:description" content="El marketplace ganadero de los Andes colombianos. Compra y vende directamente sin intermediarios." />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Agroup | Marketplace Ganadero - Manizales, Colombia</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500&amp;family=Inter:wght@300;400;500;600;700;800&amp;family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,500;1,600&amp;display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#FFFDF7] font-sans text-[#2D2D2D] antialiased">
    {!hideNav && <Navbar variant={navVariant || 'dark'} />}
    <main class={hideNav ? 'min-h-screen pt-0' : 'min-h-screen pt-[64px]'}>
      <slot />
    </main>
    <Footer />
    <CartDrawer />
    <FavoritesDrawer />
  </body>
</html>
