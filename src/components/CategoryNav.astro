---

<section class="border-b border-[#E8E0D8] bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between py-4">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 bg-gold-100 rounded-lg flex items-center justify-center">
          <svg class="w-4 h-4 text-gold-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
          </svg>
        </div>
        <div>
          <h2 class="text-sm font-bold text-[#2D2D2D]">Categorías</h2>
          <p class="text-xs text-[#6B6B6B]">{todasLasCategorias.reduce((acc, c) => acc + c.cantidad, 0)} productos disponibles</p>
        </div>
      </div>
    </div>
    
    <div class="flex items-center gap-2 pb-4 overflow-x-auto scrollbar-hide">
      <a
        href="/marketplace"
        class="flex-shrink-0 flex items-center gap-2.5 px-5 py-2.5 bg-gradient-to-r from-gold-600 to-gold-700 text-white text-sm font-bold rounded-full hover:from-gold-700 hover:to-gold-800 shadow-sm hover:shadow-md transition-all duration-200 active:scale-[0.98]"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" stroke-linecap="round"/>
        </svg>
        Todos
      </a>
      {todasLasCategorias.map((cat) => (
<a
    href="/marketplace?categoria={slugMap[cat.nombre]}"
    class:list={[`inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-medium transition-all duration-200`, current === slugMap[cat.nombre] ? 'bg-campo-600 text-white shadow-md shadow-campo-200' : 'bg-white text-[#6B6B6B] border border-[#E8E0D8] hover:border-campo-400 hover:text-campo-600 hover:shadow-sm']}>
    {cat.nombre}
  </a>
      ))}
    </div>
  </div>
</section>
