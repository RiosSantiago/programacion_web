  { id: 2, nombre: 'Equinos', icono: '🐴', color: 'bg-blue-100 text-blue-700', cantidad: 42 },
  { id: 3, nombre: 'Porcinos', icono: '🐷', color: 'bg-coral-100 text-coral-700', cantidad: 156 },
  { id: 4, nombre: 'Ovinos', icono: '🐑', color: 'bg-purple-100 text-purple-700', cantidad: 0 },
  { id: 5, nombre: 'Avicolas', icono: '🐔', color: 'bg-orange-100 text-orange-700', cantidad: 89 },
  { id: 6, nombre: 'Agricultura', icono: '🌱', color: 'bg-campo-100 text-campo-700', cantidad: 0 },
  { id: 7, nombre: 'Insumos', icono: '🧰', color: 'bg-stone-100 text-stone-700', cantidad: 0 },
