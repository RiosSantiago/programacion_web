---
---

<!-- Overlay -->
<div id="cart-overlay" class="fixed inset-0 bg-black/40 z-40 hidden backdrop-blur-sm transition-opacity" onclick="cerrarCarrito()"></div>

<!-- Cart Drawer -->
<div
  id="cart-drawer"
  class="fixed top-0 right-0 h-full w-full sm:w-[28rem] bg-white shadow-2xl z-50 transform translate-x-full transition-transform duration-300 flex flex-col"
>
  <!-- Header -->
  <div class="flex items-center justify-between p-5 border-b border-[#E8E0D8] bg-gradient-to-r from-campo-700 to-campo-800">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 bg-campo-600 rounded-xl flex items-center justify-center">
        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
      </div>
      <div>
        <h3 class="text-lg font-display font-bold text-white">Mi Carrito</h3>
        <span id="cart-count" class="text-sm text-gold-300 font-medium">0 items</span>
      </div>
    </div>
    <button onclick="cerrarCarrito()" class="w-10 h-10 flex items-center justify-center rounded-xl text-gold-300 hover:bg-campo-600 hover:text-white transition-colors">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Cart Items -->
  <div id="cart-items" class="flex-1 overflow-y-auto p-5 space-y-4">
    <!-- Empty state -->
    <div id="cart-empty" class="flex flex-col items-center justify-center h-full text-center py-12">
      <div class="w-24 h-24 bg-[#FFFDF7] rounded-2xl flex items-center justify-center mb-6 border border-[#E8E0D8]">
        <svg class="w-12 h-12 text-[#C4B09C]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
      </div>
      <h4 class="text-lg font-display font-bold text-[#2D2D2D] mb-2">Tu carrito está vacío</h4>
      <p class="text-sm text-[#6B6B6B] mb-6">Explora nuestro marketplace y encuentra los mejores productos del campo colombiano</p>
      <a href="/marketplace" onclick="cerrarCarrito()" class="btn-primary">
        Explorar Marketplace
      </a>
    </div>
  </div>

  <!-- Footer -->
  <div id="cart-footer" class="hidden border-t border-[#E8E0D8] bg-white">
    <div class="p-5 space-y-4">
      <div class="space-y-3">
        <div class="flex justify-between text-sm">
          <span class="text-[#6B6B6B]">Subtotal</span>
          <span class="font-medium text-[#2D2D2D]" id="cart-subtotal">$0</span>
        </div>
        <div class="flex justify-between text-sm">
          <span class="text-[#6B6B6B]">Transporte estimado</span>
          <span class="font-medium text-[#2D2D2D]" id="cart-transporte">$150.000</span>
        </div>
        <div class="flex justify-between text-xl font-extrabold text-[#2D2D2D] pt-3 border-t border-[#E8E0D8]">
          <span>Total</span>
          <span id="cart-total">$0</span>
        </div>
      </div>
      <a
        href="/checkout"
        id="checkout-btn"
        class="block w-full py-4 bg-campo-600 text-white text-center font-bold rounded-xl shadow-lg hover:bg-campo-700 transition-all duration-200 active:scale-[0.98]"
      >
        Finalizar Pedido
      </a>
      <button
        onclick="vaciarCarrito()"
        class="w-full py-2 text-center text-sm text-[#6B6B6B] hover:text-coral-500 font-medium transition-colors"
      >
        Vaciar carrito
      </button>
    </div>
  </div>
</div>

<script>
  interface CartItem {
    id: number;
    nombre: string;
    precio: number;
    imagen: string;
    vendedor: string;
    cantidad: number;
  }

  let carrito: CartItem[] = [];

  function formatearCOP(valor: number): string {
    return new Intl.NumberFormat('es-CO', {
      style: 'currency',
      currency: 'COP',
      minimumFractionDigits: 0,
      maximumFractionDigits: 0,
    }).format(valor);
  }

  function abrirCarrito() {
    document.getElementById('cart-overlay')?.classList.remove('hidden');
    document.getElementById('cart-drawer')?.classList.remove('translate-x-full');
    document.body.style.overflow = 'hidden';
  }

  function cerrarCarrito() {
    document.getElementById('cart-overlay')?.classList.add('hidden');
    document.getElementById('cart-drawer')?.classList.add('translate-x-full');
    document.body.style.overflow = '';
  }

  function agregarAlCarrito(item: CartItem) {
    const existente = carrito.find(c => c.id === item.id);
    if (existente) {
      existente.cantidad += item.cantidad || 1;
    } else {
      carrito.push({ ...item, cantidad: item.cantidad || 1 });
    }
    actualizarCarrito();
    saveCart();
    abrirCarrito();
  }

  function eliminarDelCarrito(id: number) {
    carrito = carrito.filter(c => c.id !== id);
    actualizarCarrito();
    saveCart();
  }

  function cambiarCantidad(id: number, delta: number) {
    const item = carrito.find(c => c.id === id);
    if (item) {
      item.cantidad += delta;
      if (item.cantidad <= 0) {
        eliminarDelCarrito(id);
        return;
      }
    }
    actualizarCarrito();
    saveCart();
  }

  function vaciarCarrito() {
    carrito = [];
    actualizarCarrito();
    saveCart();
  }

  function actualizarCarrito() {
    const container = document.getElementById('cart-items');
    const emptyState = document.getElementById('cart-empty');
    const footer = document.getElementById('cart-footer');
    const countBadge = document.getElementById('cart-count');

    const totalItems = carrito.reduce((sum, item) => sum + item.cantidad, 0);
    if (countBadge) countBadge.textContent = `${totalItems} item${totalItems !== 1 ? 's' : ''}`;

    if (carrito.length === 0) {
      container.innerHTML = `
        <div id="cart-empty" class="flex flex-col items-center justify-center h-full text-center py-12">
          <div class="w-24 h-24 bg-[#FFFDF7] rounded-2xl flex items-center justify-center mb-6 border border-[#E8E0D8]">
            <svg class="w-12 h-12 text-[#C4B09C]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <h4 class="text-lg font-display font-bold text-[#2D2D2D] mb-2">Tu carrito está vacío</h4>
          <p class="text-sm text-[#6B6B6B] mb-6">Explora nuestro marketplace y encuentra los mejores productos del campo colombiano</p>
          <a href="/marketplace" onclick="cerrarCarrito()" class="btn-primary">
            Explorar Marketplace
          </a>
        </div>
      `;
      footer?.classList.add('hidden');
      return;
    }

    footer?.classList.remove('hidden');

    container.innerHTML = '';
    carrito.forEach(item => {
      const itemEl = document.createElement('div');
      itemEl.className = 'flex gap-4 p-4 bg-white rounded-2xl border border-[#E8E0D8] shadow-sm hover:shadow-md transition-shadow';
      itemEl.innerHTML = `
        <img src="${item.imagen}" alt="${item.nombre}" class="w-20 h-20 rounded-xl object-cover flex-shrink-0" />
        <div class="flex-1 min-w-0">
          <h4 class="text-sm font-bold text-[#2D2D2D] truncate">${item.nombre}</h4>
          <p class="text-xs text-[#6B6B6B] mt-0.5">${item.vendedor}</p>
          <p class="text-lg font-extrabold text-[#2D2D2D] mt-1">${formatearCOP(item.precio)}</p>
          <div class="flex items-center justify-between mt-3">
            <div class="flex items-center gap-2">
              <button onclick="cambiarCantidad(${item.id}, -1)" class="w-8 h-8 flex items-center justify-center rounded-lg bg-[#FFFDF7] text-[#6B6B6B] hover:bg-gold-50 hover:text-gold-700 transition-colors text-sm font-bold border border-[#E8E0D8]">-</button>
              <span class="w-10 text-center text-sm font-semibold text-[#2D2D2D]">${item.cantidad}</span>
              <button onclick="cambiarCantidad(${item.id}, 1)" class="w-8 h-8 flex items-center justify-center rounded-lg bg-[#FFFDF7] text-[#6B6B6B] hover:bg-gold-50 hover:text-gold-700 transition-colors text-sm font-bold border border-[#E8E0D8]">+</button>
            </div>
            <button onclick="eliminarDelCarrito(${item.id})" class="text-xs text-coral-500 hover:text-coral-700 font-medium transition-colors">Eliminar</button>
          </div>
        </div>
      `;
      container.appendChild(itemEl);
    });

    const subtotal = carrito.reduce((sum, item) => sum + (item.precio * item.cantidad), 0);
    const transporte = carrito.length > 0 ? 150000 : 0;
    const total = subtotal + transporte;

    const subtotalEl = document.getElementById('cart-subtotal');
    const transporteEl = document.getElementById('cart-transporte');
    const totalEl = document.getElementById('cart-total');

    if (subtotalEl) subtotalEl.textContent = formatearCOP(subtotal);
    if (transporteEl) transporteEl.textContent = formatearCOP(transporte);
    if (totalEl) totalEl.textContent = formatearCOP(total);
  }

  function saveCart() {
    try {
      localStorage.setItem('agroup_cart', JSON.stringify(carrito));
      document.dispatchEvent(new CustomEvent('cart-updated'));
    } catch (e) {}
  }

  function loadCart() {
    try {
      const saved = localStorage.getItem('agroup_cart');
      if (saved) {
        carrito = JSON.parse(saved);
        actualizarCarrito();
      }
    } catch (e) {}
  }

  // Expose functions globally
  (window as any).agregarAlCarrito = agregarAlCarrito;
  (window as any).eliminarDelCarrito = eliminarDelCarrito;
  (window as any).cambiarCantidad = cambiarCantidad;
  (window as any).vaciarCarrito = vaciarCarrito;
  (window as any).abrirCarrito = abrirCarrito;
  (window as any).cerrarCarrito = cerrarCarrito;

  // Load cart on page load
  loadCart();

  // Listen for add to cart buttons
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.agregar-carrito-btn');
    if (btn) {
      const item = {
        id: parseInt(btn.getAttribute('data-id') || '0'),
        nombre: btn.getAttribute('data-nombre') || '',
        precio: parseFloat(btn.getAttribute('data-precio') || '0'),
        imagen: btn.getAttribute('data-imagen') || '',
        vendedor: btn.getAttribute('data-vendedor') || '',
        cantidad: 1,
      };
      agregarAlCarrito(item);
    }
  });

  // Open cart when clicking cart icon
  document.addEventListener('click', (e) => {
    const cartBtn = (e.target as HTMLElement).closest('[data-open-cart]');
    if (cartBtn) {
      abrirCarrito();
    }
  });
</script>
