---
const transacciones = [
  {
    id: 'TXN-001',
    tipo: 'venta',
    activo: 'Lote Bovinos - 5 Cabezas',
    contraparte: 'Hacienda El Porvenir',
    fecha: '08 May 2026',
    monto: 18500000,
    estado: 'completada',
    trazabilidad: 'ICA-TRA-2026-0842',
  },
  {
    id: 'TXN-002',
    tipo: 'compra',
    activo: 'Equino Pura Sangre - Spirit',
    contraparte: 'Caballeriza San Jorge',
    fecha: '02 May 2026',
    monto: 8500000,
    estado: 'completada',
    trazabilidad: 'ICA-TRA-2026-0791',
  },
  {
    id: 'TXN-003',
    tipo: 'venta',
    activo: 'Porcinos - Lote C (12 unidades)',
    contraparte: 'Granja Los Pinos',
    fecha: '25 Abr 2026',
    monto: 7200000,
    estado: 'completada',
    trazabilidad: 'ICA-TRA-2026-0756',
  },
  {
    id: 'TXN-004',
    tipo: 'compra',
    activo: 'Concentrado Alimenticio 2.5 Ton',
    contraparte: 'Agroinsumos del Campo',
    fecha: '18 Abr 2026',
    monto: 3200000,
    estado: 'pendiente',
    trazabilidad: '-',
  },
  {
    id: 'TXN-005',
    tipo: 'venta',
    activo: 'Bovino Holstein - Arete #018',
    contraparte: 'Finca Monte Verde',
    fecha: '10 Abr 2026',
    monto: 4200000,
    estado: 'completada',
    trazabilidad: 'ICA-TRA-2026-0712',
  },
];

function formatMoneda(val: number): string {
  return '$' + val.toLocaleString('es-CO');
}
---

<div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
  <div class="px-6 py-4 border-b border-slate-200 flex items-center justify-between">
    <div>
      <h3 class="text-lg font-semibold text-slate-900">Historial de Transacciones</h3>
      <p class="text-sm text-slate-500 mt-0.5">Compras y ventas realizadas en el marketplace</p>
    </div>
    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-emerald-700 bg-emerald-50 rounded-full">
      {transacciones.length} movimientos
    </span>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full">
      <thead>
        <tr class="bg-slate-50 border-b border-slate-200">
          <th class="text-left px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">ID</th>
          <th class="text-left px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">Tipo</th>
          <th class="text-left px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">Activo</th>
          <th class="text-left px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">Contraparte</th>
          <th class="text-left px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">Fecha</th>
          <th class="text-right px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">Monto</th>
          <th class="text-center px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">Estado</th>
          <th class="text-left px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">Trazabilidad</th>
          <th class="text-center px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">Guía ICA</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        {transacciones.map((t) => (
          <tr class="hover:bg-slate-50 transition-colors">
            <td class="px-6 py-4 text-sm font-mono font-medium text-slate-900">{t.id}</td>
            <td class="px-6 py-4">
              <span class={`inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold ${
                t.tipo === 'venta' ? 'bg-emerald-100 text-emerald-700' : 'bg-blue-100 text-blue-700'
              }`}>
                {t.tipo === 'venta' ? (
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                  </svg>
                ) : (
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 17h8m0 0V9m0 8l-8-8-4 4-6-6" />
                  </svg>
                )}
                {t.tipo === 'venta' ? 'Venta' : 'Compra'}
              </span>
            </td>
            <td class="px-6 py-4 text-sm font-medium text-slate-900">{t.activo}</td>
            <td class="px-6 py-4 text-sm text-slate-600">{t.contraparte}</td>
            <td class="px-6 py-4 text-sm text-slate-500">{t.fecha}</td>
            <td class="px-6 py-4 text-sm font-bold text-slate-900 text-right">{formatMoneda(t.monto)}</td>
            <td class="px-6 py-4 text-center">
              <span class={`inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold ${
                t.estado === 'completada' ? 'bg-emerald-100 text-emerald-700' : 'bg-amber-100 text-amber-700'
              }`}>
                {t.estado === 'completada' ? 'Completada' : 'Pendiente'}
              </span>
            </td>
            <td class="px-6 py-4 text-sm font-mono text-slate-500">
              {t.trazabilidad !== '-' ? (
                <span class="text-emerald-600 hover:underline cursor-pointer">{t.trazabilidad}</span>
              ) : (
                <span class="text-slate-300">—</span>
              )}
            </td>
            <td class="px-6 py-4 text-center">
              {t.estado === 'completada' && t.trazabilidad !== '-' ? (
                <button
                  class="inline-flex items-center gap-1 px-2.5 py-1.5 text-xs font-semibold bg-blue-50 text-blue-700 rounded-lg hover:bg-blue-100 transition-colors"
                  data-ica-txn="{t.id}"
                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" />
                  </svg>
                  Adjuntar
                </button>
              ) : (
                <span class="text-slate-300 text-xs">—</span>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <!-- ICA Modal -->
  <div id="ica-modal" class="hidden fixed inset-0 z-50">
    <div class="absolute inset-0 bg-black/50" onclick="cerrarICAModal()"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-md bg-white rounded-2xl p-6 shadow-2xl">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-bold text-slate-900">Adjuntar Guía de Movilización ICA</h3>
        <button onclick="cerrarICAModal()" class="p-2 hover:bg-slate-100 rounded-xl transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <form id="ica-form" class="space-y-4">
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5">Transacción</label>
          <input type="text" id="ica-txn" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm" readonly />
        </div>
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5">Código de guía ICA</label>
          <input type="text" id="ica-codigo" placeholder="Ej: ICA-MOV-2026-XXXX" class="w-full px-4 py-2.5 bg-white border border-slate-200 rounded-xl text-sm focus:border-emerald-400 focus:ring-2 focus:ring-emerald-100 transition-all" required />
        </div>
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5">Documento (PDF)</label>
          <div class="border-2 border-dashed border-slate-200 rounded-xl p-6 text-center hover:border-emerald-300 transition-colors cursor-pointer">
            <input type="file" accept=".pdf" class="hidden" id="ica-file" />
            <svg class="w-8 h-8 text-slate-300 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
            </svg>
            <p class="text-sm text-slate-500">Arrastra o haz clic para adjuntar la guía ICA</p>
            <p class="text-xs text-slate-400 mt-1">Solo PDF, máximo 10 MB</p>
          </div>
        </div>
        <button type="submit" class="w-full py-3 bg-gradient-to-r from-emerald-600 to-emerald-700 text-white font-bold rounded-xl shadow-sm hover:shadow-md hover:from-emerald-700 hover:to-emerald-800 active:scale-[0.98] transition-all duration-200">
          Subir Guía ICA
        </button>
      </form>
      <div id="ica-gracias" class="hidden text-center py-6">
        <svg class="w-16 h-16 text-emerald-500 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <p class="text-lg font-bold text-slate-900">¡Guía registrada!</p>
        <p class="text-sm text-slate-500 mt-1">La guía de movilización ICA ha sido adjuntada exitosamente.</p>
      </div>
    </div>
  </div>

  <div class="px-6 py-3 border-t border-slate-100 bg-slate-50 flex items-center justify-between">
    <p class="text-xs text-slate-500">Total de ingresos por ventas: <span class="font-semibold text-emerald-700">{formatMoneda(29900000)}</span></p>
    <button class="text-xs font-medium text-emerald-600 hover:text-emerald-700 hover:underline">Ver todas las transacciones →</button>
  </div>
</div>

<script>
  (window as any).cerrarICAModal = function() {
    document.getElementById('ica-modal')?.classList.add('hidden');
  };

  document.querySelectorAll('[data-ica-txn]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const txnId = (e.currentTarget as HTMLElement).dataset.icaTxn;
      (document.getElementById('ica-txn') as HTMLInputElement).value = txnId || '';
      document.getElementById('ica-modal')?.classList.remove('hidden');
    });
  });

  document.getElementById('ica-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const codigo = (document.getElementById('ica-codigo') as HTMLInputElement)?.value;
    if (!codigo) return;
    const guias = JSON.parse(localStorage.getItem('agrotech_guias_ica') || '[]');
    guias.push({
      txn: (document.getElementById('ica-txn') as HTMLInputElement)?.value,
      codigo,
      fecha: new Date().toISOString(),
      archivo: 'guia_movilizacion.pdf',
    });
    localStorage.setItem('agrotech_guias_ica', JSON.stringify(guias));
    document.getElementById('ica-form')!.classList.add('hidden');
    document.getElementById('ica-gracias')!.classList.remove('hidden');
    setTimeout(() => {
      document.getElementById('ica-modal')?.classList.add('hidden');
      document.getElementById('ica-form')!.classList.remove('hidden');
      document.getElementById('ica-gracias')!.classList.add('hidden');
      (document.getElementById('ica-form') as HTMLFormElement)?.reset();
    }, 2000);
  });

  document.querySelector('.border-dashed input[type="file"]')?.addEventListener('change', (e: any) => {
    const file = e.target.files?.[0];
    if (file) {
      const label = e.target.closest('.border-dashed')?.querySelector('p');
      if (label) label.textContent = file.name;
    }
  });
</script>
