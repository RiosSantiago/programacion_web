---
import Navbar from '../Navbar.astro';
const { navVariant = 'home' } = Astro.props;
---


<svg width="0" height="0" class="absolute">
  <defs>
    <clipPath id="heroWave" clipPathUnits="objectBoundingBox">
      <path d="M0,0 L1,0 L1,0.88 C0.88,0.96 0.77,0.80 0.66,0.88 C0.55,0.96 0.44,0.80 0.33,0.88 C0.22,0.96 0.11,0.80 0,0.88 Z" />
    </clipPath>
  </defs>
</svg>

<!-- Hero clipped section wrapped in white bg so the wave clipped area shows #FFFDF7 -->
<div class="relative z-[2] bg-[#FFFDF7]">
<section
  class="relative z-10 min-h-[70vh] lg:min-h-[80vh] overflow-hidden"
  style="clip-path: url(#heroWave)"
>
  <video src="/videos/hero-intro.mp4" autoplay muted loop playsinline preload="auto" class="absolute inset-0 w-full h-full object-cover"></video>
  <div class="absolute inset-0" style="background: linear-gradient(180deg, rgba(0,0,0,0.35) 0%, rgba(0,0,0,0.25) 30%, rgba(0,0,0,0.45) 100%);"></div>

    <div class="relative z-10 min-h-[70vh] lg:min-h-[80vh] flex items-center justify-center">
      <div class="w-full py-20 lg:py-28">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="max-w-3xl mx-auto text-center">

            <h1 class="text-4xl md:text-5xl lg:text-7xl font-display font-bold text-transparent bg-clip-text bg-gradient-to-r from-gold-300 via-gold-400 to-gold-500 leading-[1.08] tracking-tight">
              El campo colombiano
              <span class="block">en tu bolsillo</span>
            </h1>

            <p class="mt-6 text-lg md:text-xl text-white/70 max-w-2xl mx-auto leading-relaxed">
              Compra y vende bovinos, equinos, porcinos y m&aacute;s.
              Directamente de los mejores productores de
              <span class="font-semibold text-white">Manizales y Caldas</span>.
            </p>

            <div class="flex flex-col sm:flex-row gap-4 mt-10 justify-center">
              <a
                href="/marketplace"
                class="group inline-flex items-center justify-center gap-2.5 px-8 py-4 bg-transparent text-white font-bold rounded-xl border-2 border-white shadow-xl shadow-black/25 hover:bg-white/10 transition-all duration-200 active:scale-[0.97]"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
                Explorar Marketplace
                <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
              <a
                href="/publicar"
                onclick="if(!localStorage.getItem('agrotech_token')){event.preventDefault();window.location.href='/auth/login?redirect=/publicar'}"
                class="inline-flex items-center justify-center gap-2.5 px-8 py-4 bg-transparent text-white font-bold rounded-xl border-2 border-white hover:bg-white/10 transition-all duration-200 active:scale-[0.97]"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                </svg>
                Publicar mi Ganado
              </a>
            </div>

          </div>
        </div>
      </div>
    </div>

    <div class="absolute bottom-0 left-0 right-0 w-full h-20 bg-gradient-to-t from-[#FFFDF7] to-transparent pointer-events-none z-20"></div>

  </section>
</div>

<!-- Navbar floats on top of video + overlay (rendered last so it is on top at same z-index level) -->
<Navbar variant="light" />
