---
import '../lib/db';
import { getCategorias } from '../lib/models/categorias';

const departamentos = ['Todos', 'Caldas', 'Risaralda', 'Quindio', 'Antioquia', 'Tolima', 'Valle', 'Meta', 'Casanare'];
const estadosProducto = [
  { id: 'todos', nombre: 'Todos' },
  { id: 'engorde', nombre: 'Engorde' },
  { id: 'produccion', nombre: 'Produccion' },
  { id: 'cria', nombre: 'Cria' },
  { id: 'levante', nombre: 'Levante' },
  { id: 'reproduccion', nombre: 'Reproduccion' },
];

const categorias = await getCategorias();

interface Props {
  categoriaActiva?: string;
}

const { categoriaActiva } = Astro.props;

const categoriaSVGs: Record<string, string> = {
  'Bovinos': `<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 4c-1.5 0-3 1-3.5 2.5-.3 1-.1 2 .3 2.5.5.5.7 1.2.7 2s-.2 1.5-.7 2c-.4.5-.6 1.3-.3 2.5.5 1.5 2 2.5 3.5 2.5s3-1 3.5-2.5c.3-1.2.1-2-.3-2.5-.5-.5-.7-1.2-.7-2s.2-1.5.7-2c.4-.5.6-1.5.3-2.5C15 5 13.5 4 12 4z" stroke-linecap="round"/><circle cx="10" cy="9" r="1" fill="currentColor"/><circle cx="14" cy="9" r="1" fill="currentColor"/></svg>`,
  'Equinos': `<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 19c0-4 2-7 4-8l1-1-1-2c0-2 2-4 5-4 1 0 2 .5 3 1.5 1-1 2-1.5 3-1.5 3 0 5 2 5 4v3" stroke-linecap="round" stroke-linejoin="round"/><path d="M20 19l-3-6" stroke-linecap="round"/><circle cx="16" cy="6" r="1" fill="currentColor"/></svg>`,
  'Porcinos': `<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><ellipse cx="12" cy="13" rx="7" ry="5"/><path d="M12 8c2 0 3.5-1 3.5-2" stroke-linecap="round"/><circle cx="16" cy="5" r="2"/><circle cx="9.5" cy="12" r="1" fill="currentColor"/></svg>`,
  'Avicolas': `<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><ellipse cx="12" cy="14" rx="6" ry="4"/><circle cx="14" cy="10" r="4"/><path d="M18 9c1 0 2-1 2-2" stroke-linecap="round"/></svg>`,
  'Cultivos': `<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22V12" stroke-linecap="round"/><path d="M12 12c-3-3-6-4-6-8 0-2 1-4 4-4 2 0 3 1 4 4 0-3 1-4 4-4 3 0 4 2 4 4 0 4-3 5-6 8" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  'Servicios': `<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
};
---

<aside class="w-full lg:w-72 flex-shrink-0">
  <div class="bg-white/80 backdrop-blur-sm rounded-2xl border border-slate-200/50 shadow-sm p-5 space-y-6">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 bg-campo-100 rounded-lg flex items-center justify-center">
          <svg class="w-4 h-4 text-campo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
          </svg>
        </div>
        <h3 class="text-base font-bold text-slate-900">Filtros</h3>
      </div>
      <a href="/marketplace" class="text-xs font-semibold text-campo-600 hover:text-campo-700 transition-colors">
        Limpiar
      </a>
    </div>

    <div>
      <h4 class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-3">Categorías</h4>
      <div class="space-y-1.5">
        <a
          href="/marketplace"
          class={`flex items-center gap-3 py-2 px-3 rounded-xl text-sm font-medium transition-all ${!categoriaActiva ? 'bg-campo-50 text-campo-700 border border-campo-200' : 'text-slate-600 hover:bg-slate-50'}`}
        >
          <span class={`w-5 h-5 rounded-lg border-2 flex items-center justify-center ${!categoriaActiva ? 'border-campo-500 bg-campo-500' : 'border-slate-300'}`}>
            {!categoriaActiva ? <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg> : ''}
          </span>
          Todos los productos
        </a>
        {categorias.map((cat) => {
          const catNombre = cat.nombre.toLowerCase();
          const isActive = categoriaActiva === catNombre;
          return (
            <a
              href={`/marketplace?categoria=${catNombre}`}
              class={`flex items-center gap-3 py-2 px-3 rounded-xl text-sm font-medium transition-all ${isActive ? 'bg-campo-50 text-campo-700 border border-campo-200' : 'text-slate-600 hover:bg-slate-50'}`}
            >
              <span class={`w-5 h-5 rounded-lg border-2 flex items-center justify-center ${isActive ? 'border-campo-500 bg-campo-500' : 'border-slate-300'}`}>
                {isActive ? <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg> : ''}
              </span>
              <span class="text-campo-600" set:html={categoriaSVGs[cat.nombre] || categoriaSVGs['Bovinos']} />
              {cat.nombre}
              <span class="ml-auto text-xs text-slate-400">{cat.cantidad}</span>
            </a>
          );
        })}
      </div>
    </div>

    <div>
      <h4 class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-3">Precio (COP)</h4>
      <div class="space-y-2">
        <div class="grid grid-cols-2 gap-2">
          <input
            type="number"
            id="precio-desde"
            placeholder="Mín"
            class="px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:border-campo-400 focus:ring-2 focus:ring-campo-100 transition-all"
          />
          <input
            type="number"
            id="precio-hasta"
            placeholder="Máx"
            class="px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:border-campo-400 focus:ring-2 focus:ring-campo-100 transition-all"
          />
        </div>
        <button
          id="aplicar-precio"
          class="w-full py-2 text-sm font-semibold text-white bg-campo-600 rounded-xl hover:bg-campo-700 transition-colors active:scale-[0.98]"
        >
          Aplicar
        </button>
      </div>
    </div>

    <div>
      <h4 class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-3">Ubicación</h4>
      <select
        id="filtro-depto"
        class="w-full px-4 py-2.5 bg-white border border-slate-200 rounded-xl text-sm focus:border-campo-400 focus:ring-2 focus:ring-campo-100 transition-all"
      >
        {departamentos.map((depto) => (
          <option value={depto === 'Todos' ? '' : depto}>{depto}</option>
        ))}
      </select>
      <button
        id="aplicar-depto"
        class="w-full mt-3 py-2.5 text-sm font-semibold text-white bg-campo-600 rounded-xl hover:bg-campo-700 transition-colors active:scale-[0.98]"
      >
        Filtrar
      </button>
    </div>

    <div class="pt-4 border-t border-slate-100">
      <label class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-3 block">Destacados</label>
      <div class="space-y-2">
        <label class="flex items-center gap-3 p-3 bg-slate-50 rounded-xl cursor-pointer hover:bg-campo-50 transition-colors group">
          <input type="checkbox" class="w-4 h-4 rounded border-slate-300 text-campo-600 focus:ring-campo-500" />
          <span class="text-sm text-slate-600 group-hover:text-campo-700">Solo ofertas</span>
          <span class="ml-auto text-xs font-bold text-red-500">-%</span>
        </label>
        <label class="flex items-center gap-3 p-3 bg-slate-50 rounded-xl cursor-pointer hover:bg-campo-50 transition-colors group">
          <input type="checkbox" class="w-4 h-4 rounded border-slate-300 text-campo-600 focus:ring-campo-500" />
          <span class="text-sm text-slate-600 group-hover:text-campo-700">Con trazabilidad</span>
          <span class="ml-auto text-xs font-bold text-campo-600">✓</span>
        </label>
        <label class="flex items-center gap-3 p-3 bg-slate-50 rounded-xl cursor-pointer hover:bg-campo-50 transition-colors group">
          <input type="checkbox" class="w-4 h-4 rounded border-slate-300 text-campo-600 focus:ring-campo-500" />
          <span class="text-sm text-slate-600 group-hover:text-campo-700">Vendedores top</span>
          <span class="ml-auto text-xs font-bold text-amber-500">★</span>
        </label>
      </div>
    </div>
  </div>
</aside>

<script>
  document.getElementById('aplicar-precio')?.addEventListener('click', () => {
    const desde = (document.getElementById('precio-desde') as HTMLInputElement)?.value;
    const hasta = (document.getElementById('precio-hasta') as HTMLInputElement)?.value;
    const params = new URLSearchParams(window.location.search);
    if (desde) params.set('precio_min', desde);
    else params.delete('precio_min');
    if (hasta) params.set('precio_max', hasta);
    else params.delete('precio_max');
    window.location.href = '/marketplace?' + params.toString();
  });

  document.getElementById('aplicar-depto')?.addEventListener('click', () => {
    const depto = (document.getElementById('filtro-depto') as HTMLSelectElement)?.value;
    const params = new URLSearchParams(window.location.search);
    if (depto) params.set('departamento', depto);
    else params.delete('departamento');
    window.location.href = '/marketplace?' + params.toString();
  });
</script>