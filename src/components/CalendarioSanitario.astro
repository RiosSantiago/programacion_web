---
const vacunasProximas = [
  { fecha: '18 May 2026', tipo: 'Fiebre Aftosa', animal: 'Bovino - Arete #024', prioridad: 'alta' },
  { fecha: '22 May 2026', tipo: 'Brucelosis', animal: 'Bovino - Arete #031', prioridad: 'alta' },
  { fecha: '05 Jun 2026', tipo: 'Triple', animal: 'Equino - Spirit', prioridad: 'media' },
  { fecha: '12 Jun 2026', tipo: 'Peste Porcina', animal: 'Porcino - Lote C', prioridad: 'media' },
];

const revisionesVeterinarias = [
  { fecha: '15 May 2026', tipo: 'Revision General', animal: 'Bovino - Arete #018', prioridad: 'alta' },
  { fecha: '20 May 2026', tipo: 'Control Sanitario', animal: 'Lote Engorde N°3', prioridad: 'media' },
  { fecha: '28 May 2026', tipo: 'Desparasitacion', animal: 'Todo el rebano', prioridad: 'baja' },
];

const partosEsperados = [
  { fecha: '25 May 2026', madre: 'Vaca #042', raza: 'Holstein', prioridad: 'alta' },
  { fecha: '08 Jun 2026', madre: 'Vaca #058', raza: 'Cebu', prioridad: 'alta' },
  { fecha: '20 Jun 2026', madre: 'Vaca #067', raza: 'Normando', prioridad: 'media' },
];

const prioridadEstilo: Record<string, string> = {
  alta: 'bg-red-100 text-red-700',
  media: 'bg-amber-100 text-amber-700',
  baja: 'bg-blue-100 text-blue-700',
};

const hoy = new Date();
function esHoy(fecha: string): boolean {
  const partes = fecha.split(' ');
  const dia = parseInt(partes[0]);
  const mes = partes[1];
  const meses = ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic'];
  const mesNum = meses.indexOf(mes);
  const fechaObj = new Date(2026, mesNum, dia);
  return fechaObj.toDateString() === hoy.toDateString();
}
---

<div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
  <div class="px-6 py-4 border-b border-slate-200 flex items-center justify-between">
    <div>
      <h3 class="text-lg font-semibold text-slate-900">Calendario Sanitario</h3>
      <p class="text-sm text-slate-500 mt-0.5">Vacunas, revisiones y partos programados</p>
    </div>
    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-emerald-50 text-emerald-700 rounded-full text-xs font-semibold">
      <span class="w-2 h-2 bg-emerald-500 rounded-full animate-pulse"></span>
      {vacunasProximas.filter(v => esHoy(v.fecha) || v.prioridad === 'alta').length} alertas activas
    </span>
  </div>

  <div class="p-6 space-y-8">
    <!-- Vacunas Proximas -->
    <div>
      <div class="flex items-center gap-2 mb-3">
        <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <h4 class="text-sm font-semibold text-slate-700">Vacunas Próximas</h4>
      </div>
      <div class="space-y-2">
        {vacunasProximas.map((v) => (
          <div class="flex items-center justify-between p-3 bg-slate-50 rounded-lg hover:bg-slate-100 transition-colors">
            <div class="flex items-center gap-3">
              <div class={`w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold ${esHoy(v.fecha) ? 'bg-red-100 text-red-600' : 'bg-emerald-100 text-emerald-600'}`}>
                {v.fecha.split(' ')[0]}
              </div>
              <div>
                <p class="text-sm font-medium text-slate-900">{v.tipo}</p>
                <p class="text-xs text-slate-500">{v.animal}</p>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <span class={`inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium ${prioridadEstilo[v.prioridad]}`}>
                {v.prioridad === 'alta' ? 'Urgente' : v.prioridad === 'media' ? 'Programado' : 'Rutina'}
              </span>
              <span class="text-xs text-slate-400">{v.fecha}</span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Revisiones Veterinarias -->
    <div>
      <div class="flex items-center gap-2 mb-3">
        <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
        </svg>
        <h4 class="text-sm font-semibold text-slate-700">Revisiones Veterinarias</h4>
      </div>
      <div class="space-y-2">
        {revisionesVeterinarias.map((r) => (
          <div class="flex items-center justify-between p-3 bg-slate-50 rounded-lg hover:bg-slate-100 transition-colors">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center text-xs font-bold text-blue-600">
                {r.fecha.split(' ')[0]}
              </div>
              <div>
                <p class="text-sm font-medium text-slate-900">{r.tipo}</p>
                <p class="text-xs text-slate-500">{r.animal}</p>
              </div>
            </div>
            <span class={`inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium ${prioridadEstilo[r.prioridad]}`}>
              {r.prioridad === 'alta' ? 'Prioritario' : r.prioridad === 'media' ? 'Normal' : 'Baja'}
            </span>
          </div>
        ))}
      </div>
    </div>

    <!-- Partos Esperados -->
    <div>
      <div class="flex items-center gap-2 mb-3">
        <svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
        </svg>
        <h4 class="text-sm font-semibold text-slate-700">Partos Esperados</h4>
      </div>
      <div class="space-y-2">
        {partosEsperados.map((p) => (
          <div class="flex items-center justify-between p-3 bg-slate-50 rounded-lg hover:bg-slate-100 transition-colors">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 bg-amber-100 rounded-full flex items-center justify-center text-xs font-bold text-amber-600">
                {p.fecha.split(' ')[0]}
              </div>
              <div>
                <p class="text-sm font-medium text-slate-900">{p.madre}</p>
                <p class="text-xs text-slate-500">{p.raza}</p>
              </div>
            </div>
            <span class="text-xs text-slate-400">{p.fecha}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>
