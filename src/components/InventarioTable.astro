---
interface Animal {
  id: string;
  nombre: string;
  raza: string;
  edad: string;
  peso: number;
  ubicacion: string;
  estado: string;
  ultimoCheck: string;
}

interface Props {
  animales: Animal[];
}

const { animales } = Astro.props;

const estadoEstilos: Record<string, string> = {
  Activo: 'bg-emerald-100 text-emerald-700',
  Alerta: 'bg-red-100 text-red-700',
  Observacion: 'bg-amber-100 text-amber-700',
};

const estadoStock: Record<string, string> = {
  Activo: 'Disponible',
  Alerta: 'Observacion',
  Observacion: 'En evaluacion',
};
---

<div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
  <div class="px-6 py-4 border-b border-slate-200 flex items-center justify-between">
    <div>
      <h3 class="text-lg font-semibold text-slate-900">Inventario Vivo</h3>
      <p class="text-sm text-slate-500 mt-0.5">{animales.length} registros activos</p>
    </div>
    <div class="flex gap-2">
      <button class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-slate-600 bg-slate-100 rounded-lg hover:bg-slate-200 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
        </svg>
        Filtrar
      </button>
      <button class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-emerald-700 bg-emerald-50 rounded-lg hover:bg-emerald-100 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        Exportar
      </button>
    </div>
  </div>

  <!-- Desktop Table -->
  <div class="hidden md:block overflow-x-auto">
    <table class="w-full">
      <thead>
        <tr class="bg-slate-50 border-b border-slate-200">
          <th class="text-left px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">ID</th>
          <th class="text-left px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">Nombre</th>
          <th class="text-left px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">Raza</th>
          <th class="text-left px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">Edad</th>
          <th class="text-left px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">Peso</th>
          <th class="text-left px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">Ubicacion</th>
          <th class="text-left px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">Estado</th>
          <th class="text-left px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">Ultimo Check</th>
          <th class="text-center px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">Publicar</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        {animales.map((animal) => (
          <tr class="hover:bg-slate-50 transition-colors">
            <td class="px-6 py-4 text-sm font-mono font-medium text-slate-900">{animal.id}</td>
            <td class="px-6 py-4 text-sm font-medium text-slate-900">{animal.nombre}</td>
            <td class="px-6 py-4 text-sm text-slate-600">{animal.raza}</td>
            <td class="px-6 py-4 text-sm text-slate-600">{animal.edad}</td>
            <td class="px-6 py-4 text-sm font-medium text-slate-700">{animal.peso} kg</td>
            <td class="px-6 py-4 text-sm text-slate-600">{animal.ubicacion}</td>
            <td class="px-6 py-4">
              <span class={`inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold ${estadoEstilos[animal.estado]}`}>
                {animal.estado}
              </span>
            </td>
            <td class="px-6 py-4 text-sm text-slate-500">{animal.ultimoCheck}</td>
            <td class="px-6 py-4 text-center">
              <a
                href={`/publicar?animal=${encodeURIComponent(animal.nombre)}&raza=${encodeURIComponent(animal.raza)}&peso=${animal.peso}&ubicacion=${encodeURIComponent(animal.ubicacion)}`}
                class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-emerald-700 bg-emerald-50 rounded-lg hover:bg-emerald-100 transition-colors"
              >
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                </svg>
                1 clic
              </a>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <!-- Mobile Cards -->
  <div class="md:hidden divide-y divide-slate-100">
    {animales.map((animal) => (
      <div class="p-4 space-y-2">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="text-xs font-mono font-medium text-slate-500 bg-slate-100 px-2 py-0.5 rounded">{animal.id}</span>
            <span class="text-sm font-semibold text-slate-900">{animal.nombre}</span>
          </div>
          <span class={`inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold ${estadoEstilos[animal.estado]}`}>
            {animal.estado}
          </span>
        </div>
        <div class="grid grid-cols-2 gap-2 text-sm">
          <div class="text-slate-500">Raza: <span class="text-slate-700 font-medium">{animal.raza}</span></div>
          <div class="text-slate-500">Peso: <span class="text-slate-700 font-medium">{animal.peso} kg</span></div>
          <div class="text-slate-500">Ubicacion: <span class="text-slate-700 font-medium">{animal.ubicacion}</span></div>
          <div class="text-slate-500">Check: <span class="text-slate-700 font-medium">{animal.ultimoCheck}</span></div>
        </div>
        <a
          href={`/publicar?animal=${encodeURIComponent(animal.nombre)}&raza=${encodeURIComponent(animal.raza)}&peso=${animal.peso}&ubicacion=${encodeURIComponent(animal.ubicacion)}`}
          class="inline-flex items-center justify-center gap-1.5 w-full px-3 py-2 text-xs font-semibold text-emerald-700 bg-emerald-50 rounded-lg hover:bg-emerald-100 transition-colors"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
          </svg>
          Publicar en Marketplace (1 clic)
        </a>
      </div>
    ))}
  </div>
</div>
