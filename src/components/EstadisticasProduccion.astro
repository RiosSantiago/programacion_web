---
const datosPeso = [
  { mes: 'Ene', peso: 180, leche: 320, conversion: 2.1 },
  { mes: 'Feb', peso: 195, leche: 335, conversion: 2.3 },
  { mes: 'Mar', peso: 210, leche: 350, conversion: 2.0 },
  { mes: 'Abr', peso: 228, leche: 340, conversion: 2.2 },
  { mes: 'May', peso: 245, leche: 365, conversion: 1.9 },
];

const mortalidadLote = [
  { lote: 'Engorde N°1', total: 45, mortalidad: 2, porcentaje: 4.4 },
  { lote: 'Cria N°3', total: 30, mortalidad: 1, porcentaje: 3.3 },
  { lote: 'Levante N°2', total: 38, mortalidad: 0, porcentaje: 0 },
  { lote: 'Porcino Lote C', total: 60, mortalidad: 3, porcentaje: 5.0 },
];

const maxPeso = Math.max(...datosPeso.map(d => d.peso));
const maxLeche = Math.max(...datosPeso.map(d => d.leche));
---

<div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h3 class="text-lg font-semibold text-slate-900">Estadísticas de Producción</h3>
      <p class="text-sm text-slate-500 mt-0.5">Peso, leche, conversión y mortalidad</p>
    </div>
    <div class="flex items-center gap-3 text-xs">
      <div class="flex items-center gap-1.5">
        <span class="w-3 h-3 rounded-full bg-emerald-500"></span>
        <span class="text-slate-600">Peso (kg)</span>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="w-3 h-3 rounded-full bg-blue-500"></span>
        <span class="text-slate-600">Leche (L)</span>
      </div>
    </div>
  </div>

  <!-- Grafica Peso por Periodo -->
  <div class="mb-8">
    <h4 class="text-sm font-semibold text-slate-700 mb-3">Peso por Período</h4>
    <div class="space-y-3">
      {datosPeso.map((d) => (
        <div class="flex items-center gap-4">
          <span class="w-8 text-xs font-medium text-slate-500">{d.mes}</span>
          <div class="flex-1 space-y-1.5">
            <div class="h-4 bg-slate-100 rounded-full overflow-hidden">
              <div class="h-full bg-gradient-to-r from-emerald-400 to-emerald-600 rounded-full" style={`width: ${(d.peso / maxPeso) * 100}%`}></div>
            </div>
            <div class="h-4 bg-slate-100 rounded-full overflow-hidden">
              <div class="h-full bg-gradient-to-r from-blue-400 to-blue-600 rounded-full" style={`width: ${(d.leche / maxLeche) * 100}%`}></div>
            </div>
          </div>
          <div class="w-20 text-right">
            <span class="text-xs font-medium text-emerald-700">{d.peso} kg</span>
            <span class="text-xs font-medium text-blue-700 block">{d.leche} L</span>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Conversion Alimenticia -->
  <div class="mb-8 p-4 bg-emerald-50 rounded-xl">
    <h4 class="text-sm font-semibold text-slate-700 mb-3">Conversión Alimenticia</h4>
    <div class="grid grid-cols-5 gap-2">
      {datosPeso.map((d) => (
        <div class="text-center">
          <p class="text-xs text-slate-500 mb-1">{d.mes}</p>
          <div class="relative h-16 bg-white rounded-lg overflow-hidden">
            <div class="absolute bottom-0 w-full bg-gradient-to-t from-emerald-400 to-emerald-300 rounded-lg" style={`height: ${(d.conversion / 2.5) * 100}%`}></div>
          </div>
          <p class="text-xs font-bold text-emerald-700 mt-1">{d.conversion}</p>
        </div>
      ))}
    </div>
    <p class="text-xs text-slate-500 mt-2">kg de alimento / kg de peso ganado — objetivo: &lt; 2.0</p>
  </div>

  <!-- Mortalidad por Lote -->
  <div>
    <h4 class="text-sm font-semibold text-slate-700 mb-3">Mortalidad por Lote</h4>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-slate-200">
            <th class="text-left py-2 text-xs font-semibold text-slate-500 uppercase">Lote</th>
            <th class="text-right py-2 text-xs font-semibold text-slate-500 uppercase">Total</th>
            <th class="text-right py-2 text-xs font-semibold text-slate-500 uppercase">Mortalidad</th>
            <th class="text-right py-2 text-xs font-semibold text-slate-500 uppercase">%</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {mortalidadLote.map((m) => (
            <tr class="hover:bg-slate-50">
              <td class="py-2 text-slate-900 font-medium">{m.lote}</td>
              <td class="py-2 text-right text-slate-700">{m.total}</td>
              <td class={`py-2 text-right font-medium ${m.mortalidad > 0 ? 'text-red-600' : 'text-emerald-600'}`}>{m.mortalidad}</td>
              <td class="py-2 text-right">
                <span class={`inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium ${m.porcentaje > 4 ? 'bg-red-100 text-red-700' : m.porcentaje > 0 ? 'bg-amber-100 text-amber-700' : 'bg-emerald-100 text-emerald-700'}`}>
                  {m.porcentaje}%
                </span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</div>
