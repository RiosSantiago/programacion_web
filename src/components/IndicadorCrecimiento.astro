---
interface Indicador {
  mes: string;
  peso: number;
  produccion: number;
}

interface Props {
  datos: Indicador[];
}

const { datos } = Astro.props;

const maxPeso = datos.length > 0 ? Math.max(...datos.map(d => d.peso)) : 1;
const maxProduccion = datos.length > 0 ? Math.max(...datos.map(d => d.produccion)) : 1;
---

<div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h3 class="text-lg font-semibold text-slate-900">Indicadores de Crecimiento</h3>
      <p class="text-sm text-slate-500 mt-0.5">Evolucion mensual del rebaño</p>
    </div>
    <div class="flex items-center gap-4 text-xs">
      <div class="flex items-center gap-1.5">
        <span class="w-3 h-3 rounded-full bg-emerald-500"></span>
        <span class="text-slate-600">Peso (kg)</span>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="w-3 h-3 rounded-full bg-blue-500"></span>
        <span class="text-slate-600">Produccion (L)</span>
      </div>
    </div>
  </div>

  <!-- Chart visual simple con barras -->
  <div class="space-y-4">
    {datos.map((dato) => (
      <div class="flex items-center gap-4">
        <span class="w-10 text-sm font-medium text-slate-500">{dato.mes}</span>
        <div class="flex-1 flex items-center gap-3">
          <!-- Barra de peso -->
          <div class="flex-1">
            <div class="h-5 bg-slate-100 rounded-full overflow-hidden">
              <div
                class="h-full bg-gradient-to-r from-emerald-400 to-emerald-600 rounded-full transition-all duration-700"
                style={`width: ${(dato.peso / maxPeso) * 100}%`}
              ></div>
            </div>
          </div>
          <span class="w-14 text-xs font-medium text-slate-700 text-right">{dato.peso} kg</span>
        </div>
        <div class="flex-1 flex items-center gap-3">
          <!-- Barra de produccion -->
          <div class="flex-1">
            <div class="h-5 bg-slate-100 rounded-full overflow-hidden">
              <div
                class="h-full bg-gradient-to-r from-blue-400 to-blue-600 rounded-full transition-all duration-700"
                style={`width: ${(dato.produccion / maxProduccion) * 100}%`}
              ></div>
            </div>
          </div>
          <span class="w-16 text-xs font-medium text-slate-700 text-right">{dato.produccion} L</span>
        </div>
      </div>
    ))}
  </div>
</div>
