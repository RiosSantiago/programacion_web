---
const currentYear = new Date().getFullYear();

const links = {
  marketplace: [
    { href: '/marketplace', label: 'Ver todos los productos' },
    { href: '/marketplace?categoria=bovino', label: 'Bovinos' },
    { href: '/marketplace?categoria=equino', label: 'Equinos' },
    { href: '/marketplace?categoria=porcino', label: 'Porcinos' },
    { href: '/marketplace?categoria=avicola', label: 'Avicolas' },
  ],
  vendedor: [
    { href: '/publicar', label: 'Publicar producto' },
    { href: '/dashboard', label: 'Mi Hacienda' },
    { href: '/dashboard', label: 'Gestionar ventas' },
    { href: '/dashboard', label: 'Estadísticas' },
  ],
  soporte: [
    { href: 'https://wa.me/573001234567', label: 'WhatsApp' },
    { href: '/sobre-nosotros', label: 'Sobre Nosotros' },
    { href: '/terminos', label: 'Términos y condiciones' },
    { href: '/privacidad', label: 'Política de privacidad' },
  ],
};
---

<footer class="bg-campo-800 text-white mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      <div class="col-span-2 md:col-span-1">
        <a href="/" class="flex items-center gap-3 mb-3">
          <div class="w-9 h-9 bg-gradient-to-br from-gold-400 to-gold-600 rounded-lg flex items-center justify-center">
            <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 21h18M9 21V10l6-6M9 21l6-12M9 21l4-8M15 21l-2 8M15 21l2-4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <span class="text-lg font-display font-bold text-white">AgroTech</span>
        </a>
        <p class="text-sm text-white/80 leading-relaxed">
          El marketplace ganadero de Colombia. 
          Compra y vende directamente sin intermediarios.
        </p>
        <div class="flex items-center gap-2 mt-4">
          <a href="https://wa.me/573001234567" class="w-8 h-8 bg-white/10 hover:bg-white/20 rounded-lg flex items-center justify-center transition-colors">
            <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
          </a>
          <a href="#" class="w-8 h-8 bg-white/10 hover:bg-white/20 rounded-lg flex items-center justify-center transition-colors">
            <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
        </div>
      </div>

      <div>
        <h4 class="text-xs font-semibold text-gold-400 uppercase tracking-wider mb-3">Marketplace</h4>
        <ul class="space-y-2">
          {links.marketplace.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-white/80 hover:text-gold-300 transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="text-xs font-semibold text-gold-400 uppercase tracking-wider mb-3">Vendedores</h4>
        <ul class="space-y-2">
          {links.vendedor.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-white/80 hover:text-gold-300 transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="text-xs font-semibold text-gold-400 uppercase tracking-wider mb-3">Soporte</h4>
        <ul class="space-y-2">
          {links.soporte.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-white/80 hover:text-gold-300 transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
      <div class="flex flex-col md:flex-row items-center justify-between gap-3">
        <div class="flex items-center gap-2 text-sm text-white/80">
          <svg class="w-3.5 h-3.5 text-gold-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" stroke-linecap="round"/>
            <path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" stroke-linecap="round"/>
          </svg>
          <span>Manizales, Caldas — Colombia</span>
        </div>
        <p class="text-sm text-white/70">
          © {currentYear} AgroTech. Todos los derechos reservados.
        </p>
      </div>
    </div>
  </div>
</footer>
