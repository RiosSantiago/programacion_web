---
import { getCategorias } from '../lib/models/categorias';
const currentYear = new Date().getFullYear();
const categorias = await getCategorias();

const categMostradas = ['bovinos', 'equinos', 'porcinos', 'ovinos', 'avicolas', 'animales', 'ganado', 'pecuario', 'pecuaria', 'agricultura'];
const links = {
  marketplace: [
    { href: '/marketplace', label: 'Ver todos' },
    ...categorias
      .filter(c => categMostradas.includes(c.slug) || categMostradas.includes(c.nombre.toLowerCase()))
      .map(c => ({ href: `/marketplace?categoria=${c.slug}`, label: c.nombre })),
  ],
  vendedores: [
    { href: '/publicar', label: 'Publicar producto' },
    { href: '/dashboard', label: 'Mi Hacienda' },
  ],
  soporte: [
    { href: '/sobre-nosotros', label: 'Sobre Nosotros' },
    { href: '/terminos', label: 'Términos y Condiciones' },
    { href: '/privacidad', label: 'Política de Privacidad' },
  ],
};
