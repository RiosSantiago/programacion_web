---
const municipiosCaldas = [
  'Aguadas',
  'Anserma',
  'Aranzazu',
  'Belalcázar',
  'Chinchiná',
  'Filadelfia',
  'La Dorada',
  'La Merced',
  'Manizales (capital)',
  'Manzanares',
  'Marmato',
  'Marquetalia',
  'Marulanda',
  'Neira',
  'Norcasia',
  'Pácora',
  'Palestina',
  'Pensilvania',
  'Riosucio',
  'Risaralda',
  'Salamina',
  'Samaná',
  'San José',
  'Supía',
  'Victoria',
  'Villamaría',
  'Viterbo',
];
---

<section class="bg-gradient-to-r from-emerald-600 to-emerald-800 rounded-2xl overflow-hidden">
  <div class="p-8 md:p-12">
    <div class="flex flex-col lg:flex-row items-center gap-8">
      <!-- Texto -->
      <div class="flex-1 text-white">
        <span class="inline-flex items-center gap-2 px-3 py-1 bg-white/20 rounded-full text-xs font-bold uppercase tracking-wider mb-4">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
          </svg>
          Para Vendedores
        </span>
        <h3 class="text-2xl md:text-3xl font-extrabold">Publica tu Ganado</h3>
        <p class="text-emerald-100 mt-3 max-w-lg">
          Vendé directamente a compradores de todo el pais. Sin intermediarios, sin comisiones abusivas. 
          Tu ganado, tu precio.
        </p>
        <ul class="space-y-2 mt-6">
          <li class="flex items-center gap-2 text-sm text-emerald-100">
            <svg class="w-4 h-4 text-emerald-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            Publicacion gratis en menos de 3 minutos
          </li>
          <li class="flex items-center gap-2 text-sm text-emerald-100">
            <svg class="w-4 h-4 text-emerald-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            Compradores verificados de todo Colombia
          </li>
          <li class="flex items-center gap-2 text-sm text-emerald-100">
            <svg class="w-4 h-4 text-emerald-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            Negociacion directa por WhatsApp
          </li>
          <li class="flex items-center gap-2 text-sm text-emerald-100">
            <svg class="w-4 h-4 text-emerald-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            Trazabilidad que genera confianza
          </li>
        </ul>
      </div>

      <!-- Formulario -->
      <div class="w-full lg:w-96 bg-white rounded-xl p-6 shadow-xl">
        <h4 class="text-lg font-bold text-slate-900 mb-4">Publicar ahora</h4>
        <form class="space-y-3">
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">¿Que queres vender?</label>
            <select class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 bg-white">
              <option>Bovinos</option>
              <option>Equinos</option>
              <option>Porcinos</option>
              <option>Avicolas</option>
              <option>Cultivos</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Titulo del anuncio</label>
            <input
              type="text"
              placeholder="Ej: Lote 20 novillos Angus"
              class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500"
            />
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Precio (COP)</label>
              <input
                type="number"
                placeholder="4000000"
                class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500"
              />
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Cantidad</label>
              <input
                type="number"
                placeholder="15"
                class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500"
              />
            </div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Municipio</label>
              <select class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 bg-white">
                <option value="">Seleccionar</option>
                {municipiosCaldas.map((mun) => (
                  <option value={mun}>{mun}</option>
                ))}
              </select>
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Departamento</label>
              <input type="text" value="Caldas" readonly tabindex="-1" class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm bg-slate-50 text-slate-500 cursor-not-allowed" />
            </div>
          </div>
          <button
            type="button"
            class="w-full py-3 bg-campo-700 text-white font-semibold rounded-lg shadow-md hover:bg-campo-600 transition-all active:scale-95"
          >
            Publicar mi Ganado
          </button>
          <p class="text-xs text-center text-slate-400">
            Al publicar aceptas nuestros terminos y condiciones
          </p>
        </form>
      </div>
    </div>
  </div>
</section>
