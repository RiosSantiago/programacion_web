# =============================================================================
# AgroUp — Plantilla de Variables de Entorno (.env.example)
# Copia este archivo a .env y asigna valores reales antes de iniciar la aplicación.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# 1. BASE DE DATOS (PostgreSQL)
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_DB=agroup
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgrespassword@127.0.0.1:5432/agroup

# ─────────────────────────────────────────────────────────────────────────────
# 2. AUTENTICACIÓN JWT (Requerido)
# ─────────────────────────────────────────────────────────────────────────────
# Clave secreta criptográfica utilizada para firmar y verificar tokens JWT.
# [⚠️ CAMBIAR OBLIGATORIAMENTE EN PRODUCCIÓN]
# Para generar un secreto criptográficamente seguro de 64 bytes (128 hex chars):
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=tu_clave_secreta_jwt_minimo_32_caracteres_cambiar_en_produccion
ADMIN_SECRET=tu_clave_secreta_aqui

# ─────────────────────────────────────────────────────────────────────────────
# 3. ADMINISTRACIÓN / ROOT (Requerido para endpoint /api/admin/root)
# ─────────────────────────────────────────────────────────────────────────────
# Clave secreta requerida en el cuerpo de la petición POST a /api/admin/root
# para inicializar usuarios con rol de superadministrador.
# [⚠️ CAMBIAR OBLIGATORIAMENTE EN PRODUCCIÓN]
ROOT_ADMIN_KEY=clave_secreta_para_crear_usuarios_root_cambiar_en_produccion

# ─────────────────────────────────────────────────────────────────────────────
# 4. PASARELA DE PAGOS WOMPI (Bancolombia)
# ─────────────────────────────────────────────────────────────────────────────
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_PRIVATE_KEY=prv_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_EVENTS_SECRET=test_events_xxxxxxxxxxxxxxxxxxxxxxxx
